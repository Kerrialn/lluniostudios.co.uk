{#
    One configurator photo with its per-photo framing (LumenFormaPhotos).
    Loaded only when the controller asks for it (data-src), unless eager.
    Options: photo, alt, class, eager (bool), attrs (raw extra attributes).
#}
{% set src = asset('images/lumen-forma/' ~ photo.file ~ '-2000.jpg') %}
{# Each version by its true width, the WebP ones up to 4000px (photo_srcset, 14 October 2026). #}
{% set srcset = photo_srcset('images/lumen-forma/' ~ photo.file) %}
{% set webpSrcset = photo_srcset('images/lumen-forma/' ~ photo.file, 'webp') %}
<picture>{{ include('partials/_webp_source.html.twig', { srcset: srcset, webp: webpSrcset, sizes: '100vw', lazy: not eager|default(false) }) }}
<img {% if eager|default(false) %}src="{{ src }}" srcset="{{ srcset }}"{% else %}data-src="{{ src }}" data-srcset="{{ srcset }}"{% endif %}
     sizes="100vw" alt="{{ alt }}" draggable="false"
     class="ll-cfg-img select-none {{ class|default('') }}"
     style="--pos: {{ photo.position }}; --fit-up: {{ photo.upright.fit }}; --pos-up: {{ photo.upright.position }}; --fit-side: {{ photo.sideways.fit }}; --pos-side: {{ photo.sideways.position }}"
     {{ attrs|default('')|raw }}></picture>
