{% extends 'base.html.twig' %}

{#
    Lumen Forma configurator ("Lighting Designs"), Site v4 prototype.
    Step 7b.1: the introduction (the design's seven-stage story, in Special
    Elite) before the configurator; the options panel (25% wide, min 300px;
    below the photo on phones) opens from "Skip to configurator" or
    "Configure Studio or Gallery". The introduction starts fresh on every visit;
    the choices are remembered (configurator_controller.js), with "Start
    again" to clear them. The panel frame moves between the six stages.
    Sub-step 7.2: the stages' size, option lists, specifications and quantity
    (data from LumenFormaConfigurator).
    Sub-step 7.3: the photo beside the panel per stage (size galleries, option
    photos, "Image Coming Soon"; the photo list is in CLAUDE.md, Pending
    content).
    Sub-step 7.4: Customise All / Individually for 2 or more lamps, with
    Lamp 1, Lamp 2, ... tabs on the option stages.
    Sub-step 7.5: the purchase route note, the review and "Cast Your Lamp" /
    "Reserve Your Design" (added to the basket by lighting_designs_add, which
    re-checks the basket rules).
    Sub-step 7.6: "Edit configuration" (?edit=<basket line>) opens revealed on
    the review with the line's design loaded; the button updates it in place.
    No footer on this page, as in the prototype.
#}
{% block title %}Lighting Designs | Llunio Studios{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-archivo{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    {% set pad = '%02d' %}
    {# The edit design is only passed when editing: an empty value would reach
       the page as [] and Stimulus rejects it for an object value. #}
    {% set configuratorValues = {
        stages: stages, stageKeys: stageKeys, sizes: sizes, groups: groups, size: defaultSize,
        maxLamps: maxLamps, basketLamps: basketLamps, maxCheckout: constant('App\\Service\\BasketRules::MAX_CHECKOUT_LAMPS'),
        notes: {
            direct: constant('App\\Service\\BasketRules::ROUTE_NOTE_DIRECT'),
            quantity: constant('App\\Service\\BasketRules::ROUTE_NOTES')[constant('App\\Service\\BasketRules::LIMIT_MESSAGE')],
            size: constant('App\\Service\\BasketRules::ROUTE_NOTES')[constant('App\\Service\\BasketRules::REQUEST_SIZE_MESSAGE')],
            custom: constant('App\\Service\\BasketRules::ROUTE_NOTES')[constant('App\\Service\\BasketRules::CUSTOM_OPTION_MESSAGE')],
            sizeAndCustom: constant('App\\Service\\BasketRules::ROUTE_NOTE_SIZE_AND_CUSTOM'),
            directSub: constant('App\\Service\\BasketRules::SUB_DIRECT'),
        },
    } %}
    {% if edit %}{% set configuratorValues = configuratorValues|merge({ edit: edit }) %}{% endif %}
    <div {{ stimulus_controller('hero-reveal', { open: editing is not null, manual: true })|stimulus_controller('configurator', configuratorValues)|stimulus_controller('lumen-story') }}
         data-action="hero-reveal:revealed->configurator#revealed hero-reveal:revealed->lumen-story#revealed">
        {# The introduction (Step 7b, the design's Lighting Designs page): the
           Gallery photos cross-fading behind the title until the first scroll,
           then the seven stages over the pinned lamp, which brightens a step
           at each one (lumen_story_controller.js). The panel opens only from
           "Skip to configurator" or "Configure Studio or Gallery". With
           reduced motion: the sections in order, no pinning or snapping. #}
        <section class="ll-story" aria-label="Lumen Forma" data-lumen-story-target="sequence">
            {# Snap points: the page top, the middle of stages 1 to 6, the end.
               Phones (7b.2): the section is 1,673 screens tall and The Sizes
               holds for four more, so its drawing pans Studio, Gallery,
               Atelier, Estate, Monument, one snap each (lumen_story_controller.js). #}
            <span class="ll-story-snap" style="top: calc(-1 * var(--ll-nav-h))" aria-hidden="true"></span>
            {% for at in [0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 7] %}
                <span class="ll-story-snap ll-story-snap-wide" style="top: {{ at / 7 * 1120 }}vh" aria-hidden="true"></span>
            {% endfor %}
            {% for at in [0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 11] %}
                <span class="ll-story-snap ll-story-snap-phone" style="top: {{ (at / 11 * 1573)|round(2) }}vh" aria-hidden="true"></span>
            {% endfor %}
            <div class="ll-story-pin">
                <div class="ll-story-photo" data-lumen-story-target="photo">
                    <div class="ll-story-frame">
                        <img src="{{ asset('images/lumen-forma/story-dim-2000.jpg') }}" srcset="{{ asset('images/lumen-forma/story-dim-1000.jpg') }} 1000w, {{ asset('images/lumen-forma/story-dim-2000.jpg') }} 2000w"
                             sizes="(max-width: 899px) and (orientation: portrait) 180vw, 134vh" loading="lazy" alt="Lumen Forma lamp, its bulb brightening as you scroll" draggable="false">
                        <img src="{{ asset('images/lumen-forma/story-lit-2000.jpg') }}" srcset="{{ asset('images/lumen-forma/story-lit-1000.jpg') }} 1000w, {{ asset('images/lumen-forma/story-lit-2000.jpg') }} 2000w"
                             sizes="(max-width: 899px) and (orientation: portrait) 180vw, 134vh" loading="lazy" alt="" aria-hidden="true" draggable="false"
                             class="ll-story-lit" data-lumen-story-target="lit">
                    </div>
                </div>

                {# Phones (7b.2): during The Sizes the drawing takes the photo's place,
                   shown whole and panning. #}
                <div class="ll-story-plan" data-lumen-story-target="plan">
                    {{ include('configurator/_sizes_drawing.html.twig', { class: 'll-story-drawing-pan', attrs: ' data-lumen-story-target="pan"' }) }}
                </div>

                <div class="ll-story-text">
                    <div class="ll-story-stage" data-lumen-story-target="stage">
                        <p class="ll-story-opening">Sculptural lighting, hand cast in liquid stone. Each one unique.</p>
                    </div>
                    <div class="ll-story-stage" data-lumen-story-target="stage">
                        <h2 class="ll-story-header">The Material</h2>
                        <p class="ll-story-body">Each lamp is cast from our own blend of aggregates, chosen for its weight, texture and depth of pigment. Monolithic, cool to the touch, and made to last.</p>
                    </div>
                    <div class="ll-story-stage" data-lumen-story-target="stage">
                        <h2 class="ll-story-header">The Process</h2>
                        <p class="ll-story-body ll-story-body-long">Every lamp begins with a hand-shaped plug. The wiring is routed and cut to size, then the lamp is cast in lifts and left to cure. Part-cured, it's de-moulded. First the timber formwork comes away, leaving its strand pattern imprinted in the stone. Then the most satisfying moment: breaking out the plug to reveal the lamp for the first time. Finally it's cleaned, wired with its switch, smart controller and fittings, sealed, and fitted with its metal feet.</p>
                    </div>
                    <div class="ll-story-stage" data-lumen-story-target="stage">
                        <h2 class="ll-story-header">The Sizes</h2>
                        {# Desktop: the drawing under the header (phones: in the photo's place). #}
                        <div class="ll-story-drawing-scroll">{{ include('configurator/_sizes_drawing.html.twig', { class: 'll-story-drawing-inline' }) }}</div>
                        <p class="ll-story-body">Five sizes, one form. Studio and Gallery can be configured and ordered here. Atelier, Estate and Monument are made in conversation with me, so together we'll choose the finishes that suit your space.</p>
                    </div>
                    <div class="ll-story-stage" data-lumen-story-target="stage">
                        <h2 class="ll-story-header">The Signature</h2>
                        <p class="ll-story-body">Each lamp is cast around a plug that is subsequently destroyed during the de-moulding process, so no two can ever be the same.</p>
                    </div>
                    <div class="ll-story-stage" data-lumen-story-target="stage">
                        <h2 class="ll-story-header">The Maker</h2>
                        <p class="ll-story-body">It started with a birthday present and a bag of cement. Years of failed casts later, concrete became liquid stone: lighter, stronger, and never quite the same twice. Every lamp still surprises me when it leaves the mould.</p>
                        <a href="{{ path('workshop') }}" class="ll-story-link"><span>Read the full story →</span></a>
                    </div>
                    <div class="ll-story-stage" data-lumen-story-target="stage">
                        <h2 class="ll-story-end">Begin your Lumen Forma.</h2>
                        <div class="ll-story-actions">
                            <button type="button" class="ll-story-button" data-action="hero-reveal#reveal">Configure Studio or Gallery</button>
                            <a href="{{ path('basket_request') }}" class="ll-story-button">Discuss a Larger Piece</a>
                        </div>
                    </div>
                </div>

                <div class="ll-story-marker" aria-label="Stage 1 of 7" data-lumen-story-target="marker">
                    <span data-lumen-story-target="markerNumber">01</span>
                    <span class="opacity-50">/ 07</span>
                </div>

                {# The hero: the Gallery photos cross-fading behind the title (the
                   configurator's idle photos and title colours), until the first
                   scroll; then it fades onto the pinned lamp. #}
                <div class="ll-story-hero">
                    {# Only the first photo loads with the page; the controller loads each
                       of the others one photo ahead of the cross-fade. #}
                    <div class="absolute inset-0" data-configurator-target="idleLayer">
                    {% for photo in idlePhotos %}
                        {% set src = asset('images/lumen-forma/' ~ photo.file ~ '-2000.jpg') %}
                        {% set srcset = asset('images/lumen-forma/' ~ photo.file ~ '-1000.jpg') ~ ' 1000w, ' ~ src ~ ' 2000w' %}
                        <img {% if loop.first %}src="{{ src }}" srcset="{{ srcset }}" fetchpriority="high"{% else %}data-src="{{ src }}" data-srcset="{{ srcset }}"{% endif %}
                             sizes="100vw" alt="Lumen Forma" draggable="false"
                             class="ll-cfg-img absolute inset-0 w-full h-full select-none transition-opacity duration-[1600ms] {{ loop.first ? 'opacity-100' : 'opacity-0' }}"
                             style="--pos: {{ photo.position }}; --fit-up: {{ photo.upright.fit }}; --pos-up: {{ photo.upright.position }}; --fit-side: {{ photo.sideways.fit }}; --pos-side: {{ photo.sideways.position }}"
                             data-configurator-target="idle" data-light-wide="{{ photo.lightWide ? 1 : 0 }}" data-light-narrow="{{ photo.lightNarrow ? 1 : 0 }}" data-light-sideways="{{ photo.lightSideways ? 1 : 0 }}">
                    {% endfor %}
                    </div>
                    {# The hidden lines give the title the same left edge and indent as the
                       Commissions intro (as on the Workshop page). #}
                    <div class="ll-cfg-hero absolute inset-x-0 top-[18%] min-[900px]:top-[22%] flex flex-col items-center min-[900px]:items-end gap-[18px] px-[clamp(20px,5vw,88px)] pointer-events-none" data-configurator-target="hero">
                        <div class="w-max max-w-full flex flex-col gap-[18px]">
                            <div aria-hidden="true" class="h-0 overflow-hidden invisible flex flex-col items-start font-archivo font-light leading-[1.04] uppercase tracking-[0.03em] text-[calc((100vw_-_40px)/21.5)] min-[900px]:text-[min(50px,calc((100vw_-_176px)/23))]">
                                <span class="block whitespace-nowrap text-[30.3px] pl-[calc(1.4*30.3px)] min-[900px]:pl-[calc(4*30.3px)]">Your bespoke design</span>
                                <span class="block whitespace-nowrap text-[30.3px]">in our signature brutalist style,</span>
                                <span class="block whitespace-nowrap text-[30.3px] pl-[calc(2.8*30.3px)] min-[900px]:pl-[calc(7*30.3px)]">custom‑built for you.</span>
                            </div>
                            <h1 class="ll-story-title -mt-[18px] flex flex-col items-start">
                                <span class="block whitespace-nowrap pl-[calc(1.4*30.3px)] min-[900px]:pl-[calc(4*30.3px)]">Lumen Forma</span>
                            </h1>
                        </div>
                    </div>
                    {# Sideways phones: bottom-left, over the dark surround of the whole-lamp photos. #}
                    <div class="ll-cfg-hero ll-story-cue" aria-hidden="true" data-configurator-target="hero">Scroll to begin</div>
                </div>

                <button type="button" class="ll-cfg-hero ll-story-skip" data-configurator-target="hero" data-action="hero-reveal#reveal">Skip to configurator →</button>
            </div>
        </section>

        <div class="ll-cfg-row">
            {# Photo #}
            <div class="ll-cfg-photo">
                {# After the reveal: the photo for the current stage. The Scale and the
                   review show the size's own gallery (looping both ways: arrows, the
                   side zones, swipe, the arrow keys); option stages show that option's
                   photo; anything without a real photo shows "Image Coming Soon". #}
                {% for slug, photos in galleries %}
                    {% set sizeName = (sizes|filter(s => s.slug == slug)|first).name %}
                    {% set loopPhotos = photos|length > 1 ? [photos|last]|merge(photos)|merge([photos|first]) : photos %}
                    <div class="absolute inset-0 overflow-hidden touch-pan-y select-none" hidden
                         role="region" aria-roledescription="carousel" aria-label="{{ sizeName }} photos"
                         data-configurator-target="gallery" data-size="{{ slug }}" data-count="{{ photos|length }}"
                         data-action="touchstart->configurator#swipeStart touchmove->configurator#swipeMove touchend->configurator#swipeEnd touchcancel->configurator#swipeEnd">
                        <div class="flex h-full" data-gallery-track>
                            {% for photo in loopPhotos %}
                                {{ include('configurator/_photo.html.twig', { photo: photo, alt: 'Lumen Forma, ' ~ sizeName, class: 'flex-none w-full h-full' }) }}
                            {% endfor %}
                        </div>
                        <div aria-hidden="true" class="absolute left-0 inset-y-0 w-[26%] cursor-w-resize" data-action="click->configurator#previousPhoto"></div>
                        <div aria-hidden="true" class="absolute right-0 inset-y-0 w-[26%] cursor-e-resize" data-action="click->configurator#nextPhoto"></div>
                        <div class="absolute left-[clamp(20px,3vw,40px)] right-[clamp(20px,3vw,40px)] bottom-[clamp(20px,3vw,32px)] flex flex-wrap items-center justify-between gap-x-5 gap-y-2.5 text-[11px] uppercase tracking-[0.16em] text-ll-ink [text-shadow:0_1px_12px_rgba(0,0,0,.6)]">
                            <span>{{ sizeName }}</span>
                            <div class="flex items-center gap-[18px]">
                                <button type="button" class="text-[15px] tracking-normal px-0.5 py-1.5 transition-opacity hover:opacity-70" aria-label="Previous photo" data-action="configurator#previousPhoto">←</button>
                                <span class="tabular-nums" aria-live="polite" data-gallery-count>01 / {{ '%02d'|format(photos|length) }}</span>
                                <button type="button" class="text-[15px] tracking-normal px-0.5 py-1.5 transition-opacity hover:opacity-70" aria-label="Next photo" data-action="configurator#nextPhoto">→</button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                {% for item in optionPhotos %}
                    {{ include('configurator/_photo.html.twig', { photo: item.photo, alt: 'Lumen Forma ' ~ item.option|lower ~ ', ' ~ item.value, class: 'absolute inset-0 w-full h-full',
                        attrs: 'hidden data-configurator-target="optionPhoto" data-group="' ~ item.option|e('html_attr') ~ '" data-value="' ~ item.value|e('html_attr') ~ '"' }) }}
                {% endfor %}
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center bg-ll-surface border-r border-[rgba(236,227,211,.08)]"
                     role="img" aria-label="Image coming soon" hidden data-configurator-target="soon">
                    <div class="font-light uppercase tracking-[0.06em] text-[clamp(26px,3vw,44px)] leading-tight">Image Coming Soon</div>
                    <div class="w-10 h-px bg-ll-ink/35"></div>
                    <div class="text-[11px] font-medium uppercase tracking-[0.2em] text-ll-mute" data-configurator-target="soonTitle"></div>
                </div>

            </div>

            {# Options panel #}
            <div class="ll-cfg-panel">
                <div class="ll-cfg-panel-inner">
                    <div class="flex justify-between items-start gap-4 flex-wrap">
                        <div class="flex flex-col gap-2 flex-[1_1_260px] min-w-0">
                            <span class="text-[18px] uppercase tracking-[0.16em] text-ll-mute">Lumen Forma</span>
                            {% if editing %}
                                <p class="text-[12px] text-ll-mute">Editing a lamp in your basket. Your changes replace it.</p>
                            {% endif %}
                            <p class="text-[13px] leading-[1.55] text-ll-mute max-w-[400px] [text-wrap:pretty]" data-configurator-target="intro">Hand-cast liquid stone lighting series. Individually poured, cured, and hand-finished to order in our Dorset Studio.</p>
                        </div>
                        <ol class="flex gap-1.5" aria-label="Stages">
                            {% for stage in stages %}
                                <li>
                                    <button type="button" class="ll-cfg-step" title="{{ stage }}" aria-label="{{ stage }}"
                                            data-configurator-target="step" data-step="{{ loop.index0 }}" data-action="configurator#jump">
                                        <span class="text-[11px] tabular-nums">{{ pad|format(loop.index) }}</span>
                                        <span class="ll-cfg-step-line"></span>
                                    </button>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>

                    <div class="flex flex-col gap-3.5">
                        <div class="flex justify-between items-baseline gap-4">
                            <span class="text-[11px] uppercase tracking-[0.2em] text-ll-mute" data-configurator-target="stageNumber">01 / {{ pad|format(stages|length) }}</span>
                            {# Clears the remembered choices (shown once something is chosen; not when editing a basket line). #}
                            {% if not editing %}<a href="{{ path('lighting_designs') }}" class="text-[11px] text-ll-mute underline underline-offset-[3px] transition-colors hover:text-ll-ink" data-configurator-target="startAgain" data-action="configurator#startAgain" hidden>Start again</a>{% endif %}
                        </div>
                        <h2 class="font-light text-[15px] leading-[1.02] uppercase tracking-[0.03em]" data-configurator-target="stageTitle">{{ stages|first }}</h2>
                    </div>

                    {# Customise Individually: which lamp the option stages are editing
                       (Lamp 1, Lamp 2, ...; built by the controller). #}
                    <div class="flex flex-wrap gap-x-[22px] gap-y-1.5 border-b border-ll-line-soft" role="group" aria-label="Lamp being configured"
                         data-configurator-target="units" hidden></div>

                    {# Stages. Options are plain lists, all starting empty (Gallery is the
                       starting size); a group only some sizes have (Bulb Count) shows for
                       those sizes only. #}
                    {% for stage in stages %}
                        {% set stageKey = stageKeys[loop.index0] %}
                        <div class="flex flex-col gap-[clamp(28px,4vw,48px)]" data-configurator-target="stage" {{ loop.first ? '' : 'hidden' }}>
                            {% if stageKey == 'scale' %}
                                {# No "Size" heading: the stage title says it. #}
                                <div class="flex flex-col gap-4" role="group" aria-label="Size">
                                    <div class="flex flex-col">
                                        {% for size in sizes %}
                                            <button type="button" class="ll-cfg-opt" aria-pressed="false"
                                                    data-configurator-target="option" data-group="size" data-value="{{ size.slug }}" data-action="configurator#choose">{{ size.name }}</button>
                                        {% endfor %}
                                    </div>
                                    <div class="text-[12px] text-ll-mute" data-configurator-target="sizeNote"></div>
                                    <div class="flex flex-col gap-3 pt-4 border-t border-ll-line-soft w-full max-w-[521px]">
                                        <div class="flex justify-between items-baseline gap-4 flex-wrap">
                                            <span class="text-[11px] uppercase tracking-[0.16em] text-ll-mute">Specifications</span>
                                            <span class="text-[13px]" data-configurator-target="spec"></span>
                                        </div>
                                        <div class="grid grid-cols-3 gap-2.5">
                                            {% for dimension in ['Length', 'Width', 'Height'] %}
                                                <div class="flex flex-col gap-1 border-l border-ll-line py-px pl-3">
                                                    <span class="text-[10.5px] uppercase tracking-[0.16em] text-ll-mute">{{ dimension }}</span>
                                                    <span class="text-base leading-[1.2] tabular-nums"><span data-configurator-target="dimension" data-dimension="{{ dimension|lower }}"></span><span class="text-xs text-ll-mute ml-[3px]">cm</span></span>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <span class="text-[11px] text-ll-mute">Measurements may vary slightly due to the handmade nature</span>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-[18px] pt-[22px] border-t border-ll-line-soft">
                                    <div class="flex justify-between items-center gap-4 flex-wrap">
                                        <span id="cfg-quantity" class="text-[11px] uppercase tracking-[0.16em] text-ll-mute">Quantity</span>
                                        <div class="flex border border-[rgba(236,227,211,.3)] text-[15px]" role="group" aria-labelledby="cfg-quantity">
                                            <button type="button" class="px-4 py-2 transition-opacity hover:opacity-70" aria-label="Fewer lamps" data-action="configurator#fewer">−</button>
                                            <span class="px-3.5 py-2 min-w-10 text-center tabular-nums" aria-live="polite" data-configurator-target="quantity">1</span>
                                            <button type="button" class="px-4 py-2 transition-opacity hover:opacity-70" aria-label="More lamps" data-action="configurator#more">+</button>
                                        </div>
                                    </div>
                                    {# Customise All / Individually, for 2 or more lamps; then the purchase
                                       route note (filled in by the controller, copy from BasketRules). #}
                                    <div class="flex flex-col gap-3" data-configurator-target="modes" hidden>
                                        <span id="cfg-modes" class="text-[14px]">How would you like to configure your lamps?</span>
                                        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,180px),1fr))] gap-2" role="group" aria-labelledby="cfg-modes">
                                            {% for mode in [{ key: 'all', label: 'Customise All', description: 'Apply the same configuration to every lamp.' }, { key: 'individual', label: 'Customise Individually', description: 'Configure each lamp separately.' }] %}
                                                <button type="button" class="ll-cfg-mode" aria-pressed="false"
                                                        data-configurator-target="mode" data-mode="{{ mode.key }}" data-action="configurator#chooseMode">
                                                    <span class="text-[11px] uppercase tracking-[0.16em] text-ll-ink">{{ mode.label }}</span>
                                                    <span class="text-[12px] leading-[1.45] text-ll-mute">{{ mode.description }}</span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1.5 border-l border-ll-line py-0.5 pl-3.5" data-configurator-target="route">
                                        <span class="text-[11px] uppercase tracking-[0.16em] text-ll-mute">Purchase route</span>
                                        <span class="text-xs leading-[1.45] text-ll-mute" data-configurator-target="routeNote">{{ constant('App\\Service\\BasketRules::ROUTE_NOTE_DIRECT') }}</span>
                                    </div>
                                </div>
                            {% elseif stageKey == 'review' %}
                                {# Review: one row per choice (or per lamp), each opening its stage;
                                   then "Cast Your Lamp" (adds to the basket) or "Reserve Your Design"
                                   (the request route), with the purchase route note under it. #}
                                <div class="flex flex-col gap-[18px]">
                                    <div class="flex flex-col" data-configurator-target="review"></div>
                                    <form method="post" action="{{ path('lighting_designs_add') }}" data-action="configurator#cast">
                                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                        <input type="hidden" name="configuration" data-configurator-target="configuration">
                                        {% if editing %}<input type="hidden" name="edit" value="{{ editing.id }}">{% endif %}
                                        <button type="submit" class="ll-cta block w-full bg-ll-ink text-ll-bg p-[18px] text-center font-medium text-[12px] uppercase tracking-[0.16em]" data-configurator-target="cta">Cast Your Lamp</button>
                                    </form>
                                    {# The same purchase route note as on The Scale. #}
                                    <div class="flex flex-col gap-1.5 border-l border-ll-line py-0.5 pl-3.5" data-configurator-target="route">
                                        <span class="text-[11px] uppercase tracking-[0.16em] text-ll-mute">Purchase route</span>
                                        <span class="text-xs leading-[1.45] text-ll-mute" data-configurator-target="routeNote">{{ constant('App\\Service\\BasketRules::ROUTE_NOTE_DIRECT') }}</span>
                                    </div>
                                    <div class="text-[12px] text-ll-mute" data-configurator-target="ctaSub">{{ constant('App\\Service\\BasketRules::SUB_DIRECT') }}</div>
                                </div>
                            {% else %}
                                {% for group in groups|filter(g => g.stage == stageKey) %}
                                    {% set groupId = 'cfg-group-' ~ group.name|lower|replace({' ': '-'}) %}
                                    <div class="flex flex-col gap-4" role="group" {% if group.heading %}aria-labelledby="{{ groupId }}"{% else %}aria-label="{{ group.name }}"{% endif %}
                                         data-configurator-target="group" data-group="{{ group.name }}" data-sizes="{{ group.sizes|join(',') }}">
                                        {% if group.heading %}
                                            <div class="flex justify-between items-baseline gap-4 flex-wrap border-b border-ll-line-soft pb-2.5"><span id="{{ groupId }}" class="text-[11px] uppercase tracking-[0.16em] text-ll-mute">{{ group.name }}</span></div>
                                        {% endif %}
                                        <div class="flex flex-col">
                                            {% for value in group.values %}
                                                <button type="button" class="ll-cfg-opt" aria-pressed="false"
                                                        data-configurator-target="option" data-group="{{ group.name }}" data-value="{{ value.value }}" data-action="configurator#choose">{{ value.value }}</button>
                                            {% endfor %}
                                        </div>
                                        {# Under a Custom choice: its description (for the lamp being edited),
                                           required while Custom is chosen ("Please describe ... to continue."
                                           when moving on without it), carried into Reserve Your Design's
                                           "Custom Details". Styled as the site's other fields
                                           (checkout/_field.html.twig), with the label a little
                                           smaller (12px) so it doesn't compete with the options. #}
                                        {% if group.prompt %}
                                            {% set describeId = groupId ~ '-describe' %}
                                            <label class="flex flex-col gap-2" for="{{ describeId }}" data-configurator-target="describe" data-group="{{ group.name }}" hidden>
                                                <span class="text-[12px] leading-[1.5]">{{ group.prompt.label }}</span>
                                                <textarea id="{{ describeId }}" rows="3" maxlength="{{ constant('App\\Catalogue\\LumenFormaCatalogue::CUSTOM_DESCRIPTION_MAX') }}"
                                                          class="min-h-24 py-3 resize-y w-full px-3.5 bg-transparent text-ll-ink placeholder:text-ll-mute [color-scheme:dark] border border-ll-mute rounded-none outline-none text-[15px] leading-[1.5] focus:border-ll-ink"
                                                          data-group="{{ group.name }}" data-action="input->configurator#describe"></textarea>
                                                <span class="text-[12px] text-ll-mute" role="alert" data-configurator-target="describeWarning" data-group="{{ group.name }}" hidden>{{ group.prompt.warning }}</span>
                                                <span class="text-[12px] text-ll-mute">{{ constant('App\\Service\\BasketRules::CUSTOM_CHOICE_NOTE') }}</span>
                                            </label>
                                        {% endif %}
                                        <div class="text-[12px] text-ll-mute" role="alert" data-configurator-target="warning" data-group="{{ group.name }}" hidden>{{ group.warning }}</div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    {% endfor %}

                    <div class="flex-1"></div>
                    <div class="flex flex-wrap justify-between items-center gap-x-4 gap-y-3 border-t border-ll-line pt-[18px]">
                        <button type="button" class="text-[12px] uppercase tracking-[0.14em] text-ll-mute opacity-0 transition-colors hover:text-ll-ink" disabled
                                data-configurator-target="back" data-action="configurator#back">← <span data-configurator-target="backTitle"></span></button>
                        <button type="button" class="ml-auto text-right max-w-full transition-opacity hover:opacity-70 text-[12px] uppercase tracking-[0.14em] min-[900px]:tracking-[0.03em] min-[900px]:whitespace-nowrap border-b border-ll-ink pb-[3px]"
                                data-configurator-target="next" data-action="configurator#next"><span data-configurator-target="nextTitle">{{ stages[1] }}</span> →</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

