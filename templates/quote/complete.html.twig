{% extends 'base.html.twig' %}

{#
    After paying a quote (Step 10b.3): as the Card Payment page's completion
    ("Order & Slot Confirmed"), with what was paid and anything still owed.
    While Stripe hasn't confirmed yet, "Order Received" as there.
#}
{% macro money(pence) %}{{ (pence / 100)|format_currency('GBP', {fraction_digit: pence % 100 == 0 ? 0 : 2}) }}{% endmacro %}
{% import _self as m %}
{% block title %}{{ order.paid ? 'Order & Slot Confirmed' : 'Order Received' }} | Llunio Studios{% endblock %}
{% block description %}Your payment to Llunio Studios has been received.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    {% if order.paid %}
        {{ include('partials/_received.html.twig', {
            heading: 'Order & Slot Confirmed',
            message: 'Added to Studio Casting Schedule',
            lines: ['Paid · ' ~ m.money(order.amountPaid)]|merge(order.amountOwed > 0 ? ['Balance to pay later · ' ~ m.money(order.amountOwed)] : []),
        }) }}
    {% else %}
        {{ include('partials/_received.html.twig', {
            heading: 'Order Received',
            message: "Thank you. We're just confirming your payment and will email you shortly.",
            confirmation: false,
        }) }}
    {% endif %}
{% endblock %}
