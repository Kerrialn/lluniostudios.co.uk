{% extends 'base.html.twig' %}

{#
    The customer's quote (Step 10b.2), laid out like Reserve Your Design and
    Card Payment: each design with its configuration and quoted price, extra
    lines, delivery, the total (no VAT), what to pay now, the casting date,
    the studio's note and the date it is valid until. Once expired, a note
    to ask for an updated quote instead.
    Paying (10b.3): the Card Payment page's fields, filled in from the request
    (the postcode must stay the one quoted), Apple Pay / Google Pay above
    them, card details, and "Pay £x" (the deposit or the whole total), with
    the same page script as Card Payment (checkout_controller.js). Once
    paid, the payment received and anything still owed instead of the form.
    The balance (10b.4): once the studio has asked for it, the name on the
    card, Stripe's boxes (or Apple Pay / Google Pay) and "Pay balance £x";
    once paid, "paid in full".
#}
{% form_theme form 'form_div_layout.html.twig' %}
{% block title %}Your Quote | Llunio Studios{% endblock %}
{% block description %}Your quote from Llunio Studios for your Lumen Forma lamp.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-archivo{% endblock %}

{% macro money(pence) %}{{ (pence / 100)|format_currency('GBP', {fraction_digit: pence % 100 == 0 ? 0 : 2}) }}{% endmacro %}
{% import _self as m %}

{% block body %}
    {% set section = 'text-[11px] uppercase tracking-[0.14em] text-ll-mute border-t border-ll-line pt-4' %}
    {% set row = 'flex justify-between gap-4 py-[9px] border-b border-ll-line text-[13px] leading-[1.5]' %}
    {% set total = 'flex justify-between gap-3 text-[13px] py-2.5 border-t border-ll-line' %}
    {% set grid = 'grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-x-5 gap-y-4' %}
    {% set payable = not expired and not paidOrder %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-[clamp(28px,4vw,48px)]">
        <div class="flex flex-col gap-3.5 max-w-[640px]">
            <h1 class="ll-heading text-[clamp(22px,2vw,32px)]">Your Quote</h1>
            <p class="m-0 text-[13px] text-ll-mute">{{ designRequest.isEnquiry ? 'Enquiry' : 'Request' }} {{ designRequest.requestNumber }}</p>
            {% if paidOrder and paidOrder.balancePaidAt %}
                <p class="m-0 text-[15px] leading-[1.5]" data-quote-paid>Thank you. Your order {{ paidOrder.orderNumber }} is paid in full.</p>
            {% elseif paidOrder and balanceForm %}
                <p class="m-0 text-[15px] leading-[1.5]" data-quote-paid>Thank you for your deposit of {{ m.money(paidOrder.amountPaid) }}, received on {{ paidOrder.paidAt|date('j F Y', 'Europe/London') }}. The balance of {{ m.money(paidOrder.amountOwed) }} for your order {{ paidOrder.orderNumber }} can be paid below.</p>
            {% elseif paidOrder %}
                <p class="m-0 text-[15px] leading-[1.5]" data-quote-paid>Thank you. Your payment of {{ m.money(paidOrder.amountPaid) }} was received on {{ paidOrder.paidAt|date('j F Y', 'Europe/London') }}{{ paidOrder.amountOwed > 0 ? ', with ' ~ m.money(paidOrder.amountOwed) ~ ' to pay later' : '' }}. Your order is {{ paidOrder.orderNumber }}.</p>
            {% elseif expired %}
                <p class="m-0 text-[15px] leading-[1.5]" role="alert">This quote expired on {{ validUntil|date('j F Y', 'Europe/London') }}. Please <a href="{{ path('contact') }}" class="ll-link">contact us</a> or reply to the quote email, and we'll send you an updated quote.</p>
            {% else %}
                {# An enquiry's quote speaks as "me" and is signed (Step 7c.4, decided 13 October 2026). #}
                <p class="m-0 text-[15px] leading-[1.5] text-ll-mute" data-quote-greeting>Dear {{ designRequest.firstName }}, here is {{ designRequest.isEnquiry ? 'my quote for your Lumen Forma enquiry' : 'our quote for your Lumen Forma request' }}. It is valid until {{ validUntil|date('j F Y', 'Europe/London') }}.</p>
            {% endif %}
            {% if quote.note and not expired %}<p class="m-0 text-[15px] leading-[1.5] whitespace-pre-line">{{ quote.note }}</p>{% endif %}
            {% if designRequest.isEnquiry and not paidOrder and not expired %}
                <div class="flex flex-col gap-3.5 text-[15px] leading-[1.5]" data-quote-signature>
                    {% for paragraph in constant('App\\Service\\EmailService::ENQUIRY_SIGNATURE')|split("\n\n") %}<p class="m-0 whitespace-pre-line">{{ paragraph }}</p>{% endfor %}
                </div>
            {% endif %}
        </div>

        {% if balanceForm %}
            {% form_theme balanceForm 'form_div_layout.html.twig' %}
            {{ form_start(balanceForm, { attr: { class: 'flex flex-wrap gap-[clamp(32px,5vw,72px)] items-start', novalidate: 'novalidate', 'data-controller': 'checkout', 'data-checkout-stripe-key-value': stripeKey, 'data-checkout-express-url-value': path('quote_balance', { token: token, wallet: 1 }), 'data-checkout-subtotal-value': paidOrder.amountOwed, 'data-checkout-wallet-address-value': 'false', 'data-action': 'submit->checkout#pay' } }) }}
        {% elseif payable %}
            {{ form_start(form, { attr: { class: 'flex flex-wrap gap-[clamp(32px,5vw,72px)] items-start', novalidate: 'novalidate', 'data-controller': 'checkout', 'data-checkout-stripe-key-value': stripeKey, 'data-checkout-express-url-value': path('quote_pay', { token: token, wallet: 1 }), 'data-checkout-subtotal-value': quote.dueNow, 'data-checkout-wallet-address-value': 'false', 'data-action': 'submit->checkout#pay' } }) }}
        {% else %}
            <div class="flex flex-wrap gap-[clamp(32px,5vw,72px)] items-start {{ expired ? 'opacity-50' : '' }}">
        {% endif %}
            <div class="flex-[1.5_1_460px] min-w-0 flex flex-col gap-6">
                <div class="{{ section }}">Your configuration</div>
                {% for lamp in quote.lamps %}
                    {% set item = lamp.item %}
                    <div class="flex flex-col" data-quote-design>
                        <div class="{{ row }}"><span class="text-ll-mute">Size</span><span class="text-right">{{ item ? item.sizeName : lamp.label }}</span></div>
                        {% if item %}
                            {% if item.finishesToBeChosen %}
                                {# A larger piece reserved with its size only (7b.4). #}
                                <div class="{{ row }}"><span class="text-ll-mute">{{ constant('App\\Catalogue\\LumenFormaCatalogue::FINISHES_KEY') }}</span><span class="text-right">{{ constant('App\\Catalogue\\LumenFormaCatalogue::FINISHES_VALUE') }}</span></div>
                            {% elseif item.customisedIndividually %}
                                {% for group in item.lampConfigurations %}
                                    {% set n = loop.index %}
                                    {% set bulb = item.value('Bulb Style', n) ~ (item.value('Bulb Count', n) ? ' / ' ~ item.value('Bulb Count', n) : '') %}
                                    <div class="{{ row }}"><span class="text-ll-mute">{{ group.label }}</span><span class="text-right">{{ [item.value('The Pigment', n), item.value('Cable Colour', n), item.value('Footing Material', n), bulb]|join(' · ') }}</span></div>
                                {% endfor %}
                            {% else %}
                                <div class="{{ row }}"><span class="text-ll-mute">The Pigment</span><span class="text-right">{{ item.value('The Pigment') }}</span></div>
                                <div class="{{ row }}"><span class="text-ll-mute">Cable Colour</span><span class="text-right">{{ item.value('Cable Colour') }}</span></div>
                                <div class="{{ row }}"><span class="text-ll-mute">Footing Material</span><span class="text-right">{{ item.value('Footing Material') }}</span></div>
                                {% if item.value('Bulb Count') %}
                                    <div class="{{ row }}"><span class="text-ll-mute">Bulb Style / Count</span><span class="text-right">{{ item.value('Bulb Style') }} / {{ item.value('Bulb Count') }}</span></div>
                                {% else %}
                                    <div class="{{ row }}"><span class="text-ll-mute">Bulb Style</span><span class="text-right">{{ item.value('Bulb Style') }}</span></div>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                        <div class="{{ row }}"><span class="text-ll-mute">Quantity</span><span class="text-right">{{ lamp.quantity }}</span></div>
                        <div class="{{ row }}"><span class="text-ll-mute">Price</span><span class="text-right">{{ m.money(lamp.unitPrice) }}{{ lamp.quantity > 1 ? ' each' : '' }}</span></div>
                    </div>
                {% endfor %}

                {% if balanceForm %}
                    <div class="flex flex-col gap-3" data-checkout-target="expressArea" hidden>
                        <div data-checkout-target="express"></div>
                        <div class="text-xs text-ll-ink" role="alert" data-checkout-target="expressMessage" hidden></div>
                    </div>
                    <div class="{{ section }}">Card details</div>
                    <div class="{{ grid }}" data-balance-card>
                        {{ include('checkout/_field.html.twig', { child: balanceForm.cardName, label: 'Name on card *', wide: true }) }}
                        {% set cardBox = 'll-card-box w-full h-12 px-3.5 flex items-center border border-ll-mute text-[15px] leading-[1.5]' %}
                        {% for box in [
                            { target: 'cardNumber', label: 'Card number *', wide: true },
                            { target: 'cardExpiry', label: 'Expiry (MM / YY) *', wide: false },
                            { target: 'cardCvc', label: 'Security code (CVC) *', wide: false },
                        ] %}
                            <div class="flex flex-col gap-2 {{ box.wide ? 'col-[1/-1]' : '' }}">
                                <span class="text-[14px]" id="{{ box.target }}-label">{{ box.label }}</span>
                                <div class="{{ cardBox }}" data-checkout-target="{{ box.target }}" role="group" aria-labelledby="{{ box.target }}-label"></div>
                                <span class="text-[12px] text-ll-ink" role="alert" hidden data-checkout-target="{{ box.target }}Error"></span>
                            </div>
                        {% endfor %}
                    </div>
                {% elseif payable %}
                    {# Apple Pay / Google Pay: shown only when the device offers one. #}
                    <div class="flex flex-col gap-3" data-checkout-target="expressArea" hidden>
                        <div data-checkout-target="express"></div>
                        <div class="text-xs text-ll-ink" role="alert" data-checkout-target="expressMessage" hidden></div>
                    </div>
                    <div class="{{ section }}">Contact</div>
                    <div class="{{ grid }}">
                        {{ include('checkout/_field.html.twig', { child: form.email, label: 'Email *' }) }}
                        {{ include('checkout/_field.html.twig', { child: form.phone, label: 'Your Mobile (for order and delivery updates) *' }) }}
                    </div>

                    <div class="{{ section }}">Delivery address{% if designRequest.directGift %} <span class="normal-case tracking-normal text-[13px]">(the recipient's: sent directly, with no prices in the box)</span>{% endif %}</div>
                    <div class="{{ grid }}">
                        {{ include('checkout/_field.html.twig', { child: form.name, label: designRequest.directGift ? "Recipient's full name *" : 'Full name *', wide: true }) }}
                        {{ include('checkout/_field.html.twig', { child: form.company, label: 'Company name (optional)', wide: true }) }}
                        {{ include('checkout/_field.html.twig', { child: form.line1, label: 'Address line 1 *', wide: true }) }}
                        {{ include('checkout/_field.html.twig', { child: form.line2, label: 'Address line 2', wide: true }) }}
                        {{ include('checkout/_field.html.twig', { child: form.town, label: 'Town/City *' }) }}
                        {{ include('checkout/_field.html.twig', { child: form.county, label: 'County' }) }}
                        {{ include('checkout/_field.html.twig', { child: form.postcode, label: 'Postcode *' }) }}
                    </div>
                    <div class="flex flex-col gap-2"><span class="text-[14px]">Country</span><div class="border border-ll-line h-12 flex items-center px-3.5 text-[15px] text-ll-mute">{{ designRequest.countryName ?? 'United Kingdom' }}</div></div>
                    <div class="{{ grid }}">
                        {{ include('checkout/_field.html.twig', { child: form.notes, label: 'Delivery instructions (optional)', wide: true }) }}
                        {% if designRequest.directGift %}
                            {{ include('checkout/_field.html.twig', { child: form.recipientPhone, label: "Recipient's mobile (optional)", hint: "(for the carrier's delivery updates; otherwise yours)", wide: true }) }}
                            {{ include('checkout/_field.html.twig', { child: form.giftMessage, label: 'Gift message (optional)', hint: '(for a card in the box, up to ' ~ constant('App\\Form\\Form\\CardPaymentForm::GIFT_MESSAGE_MAX') ~ ' characters)', area: true, wide: true }) }}
                        {% else %}
                            {% do form.recipientPhone.setRendered %}{% do form.giftMessage.setRendered %}
                        {% endif %}
                    </div>

                    <div class="{{ section }}">Billing address</div>
                    <div class="group/bill flex flex-col gap-6">
                        <label class="min-h-11 flex items-center gap-3 text-[14px] cursor-pointer select-none transition-opacity hover:opacity-70">
                            {{ form_widget(form.billingSame, { attr: { class: 'peer sr-only' } }) }}
                            <span class="flex-none w-4 h-4 border border-ll-ink flex items-center justify-center peer-focus-visible:outline peer-focus-visible:outline-1 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ll-ink *:bg-transparent peer-checked:*:bg-ll-ink" aria-hidden="true"><span class="w-2 h-2"></span></span>
                            Same as delivery address
                        </label>
                        <div class="{{ grid }} group-has-[input[name$='[billingSame]']:checked]/bill:hidden">
                            {{ include('checkout/_field.html.twig', { child: form.billingName, label: 'Full name *', wide: true }) }}
                            {{ include('checkout/_field.html.twig', { child: form.billingLine1, label: 'Address line 1 *', wide: true }) }}
                            {{ include('checkout/_field.html.twig', { child: form.billingLine2, label: 'Address line 2', wide: true }) }}
                            {{ include('checkout/_field.html.twig', { child: form.billingTown, label: 'Town/City *' }) }}
                            {{ include('checkout/_field.html.twig', { child: form.billingCounty, label: 'County' }) }}
                            {{ include('checkout/_field.html.twig', { child: form.billingPostcode, label: 'Postcode *' }) }}
                        </div>
                    </div>

                    <div class="{{ section }}">Card details</div>
                    <div class="{{ grid }}">
                        {{ include('checkout/_field.html.twig', { child: form.cardName, label: 'Name on card *', wide: true }) }}
                        {% set cardBox = 'll-card-box w-full h-12 px-3.5 flex items-center border border-ll-mute text-[15px] leading-[1.5]' %}
                        {% for box in [
                            { target: 'cardNumber', label: 'Card number *', wide: true },
                            { target: 'cardExpiry', label: 'Expiry (MM / YY) *', wide: false },
                            { target: 'cardCvc', label: 'Security code (CVC) *', wide: false },
                        ] %}
                            <div class="flex flex-col gap-2 {{ box.wide ? 'col-[1/-1]' : '' }}">
                                <span class="text-[14px]" id="{{ box.target }}-label">{{ box.label }}</span>
                                <div class="{{ cardBox }}" data-checkout-target="{{ box.target }}" role="group" aria-labelledby="{{ box.target }}-label"></div>
                                <span class="text-[12px] text-ll-ink" role="alert" hidden data-checkout-target="{{ box.target }}Error"></span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <aside class="flex-[1_1_320px] min-w-0 flex flex-col gap-[18px] p-[clamp(20px,3vw,32px)] bg-ll-surface border border-ll-line" data-quote-summary>
                <div class="text-[11px] uppercase tracking-[0.14em] text-ll-mute">Quote</div>
                <div class="flex flex-col">
                    {% for lamp in quote.lamps %}
                        <div class="{{ row }}"><span>{{ lamp.label }}{{ lamp.quantity > 1 ? ' × ' ~ lamp.quantity : '' }}</span><span class="text-right">{{ m.money(lamp.total) }}</span></div>
                    {% endfor %}
                    {% for extra in quote.extras %}
                        <div class="{{ row }}"><span>{{ extra.label }}</span><span class="text-right">{{ m.money(extra.total) }}</span></div>
                    {% endfor %}
                    <div class="{{ row }}"><span>Delivery · {{ quote.deliveryLabel }}</span><span class="text-right">{{ m.money(quote.deliveryPrice) }}</span></div>
                    {% if designRequest.gift %}
                        <div class="{{ row }}" data-quote-gift><span>Gift</span><span class="text-right">Needed by {{ designRequest.giftNeededBy|date('j F Y') }}{% if designRequest.giftSendTo %}<br>{{ designRequest.giftSendTo.label }}{% endif %}</span></div>
                    {% endif %}
                </div>
                <div class="flex flex-col">
                    <div class="{{ total }} text-[15px]"><span>Total</span><span>{{ m.money(quote.total) }}</span></div>
                    {% if quote.deposit %}
                        <div class="{{ total }}"><span>Deposit to pay now ({{ quote.depositPercent }}%)</span><span>{{ m.money(quote.dueNow) }}</span></div>
                        <div class="{{ total }}"><span class="text-ll-mute">Balance to pay later</span><span class="text-ll-mute">{{ m.money(quote.balance) }}</span></div>
                    {% else %}
                        <div class="{{ total }}"><span>To pay now</span><span>{{ m.money(quote.dueNow) }}</span></div>
                    {% endif %}
                </div>
                <div class="{{ row }} border-t"><span class="text-ll-mute">Estimated casting date</span><span class="text-right">{{ quote.castingDate|date('j F Y') }}</span></div>
                {% if paidOrder and paidOrder.balancePaidAt %}
                    <div class="flex flex-col" data-quote-payments>
                        <div class="{{ total }}"><span>Deposit {{ paidOrder.paidAt|date('j F Y', 'Europe/London') }}</span><span>{{ m.money(paidOrder.chargeNow) }}</span></div>
                        <div class="{{ total }}"><span>Balance {{ paidOrder.balancePaidAt|date('j F Y', 'Europe/London') }}</span><span>{{ m.money(paidOrder.total - paidOrder.chargeNow) }}</span></div>
                        <div class="{{ total }}"><span>Paid in full</span><span>{{ m.money(paidOrder.total) }}</span></div>
                    </div>
                {% elseif paidOrder %}
                    <div class="flex flex-col" data-quote-payments>
                        <div class="{{ total }}"><span>Paid {{ paidOrder.paidAt|date('j F Y', 'Europe/London') }}</span><span>{{ m.money(paidOrder.amountPaid) }}</span></div>
                        <div class="{{ total }}"><span class="{{ paidOrder.amountOwed > 0 ? '' : 'text-ll-mute' }}">Still to pay</span><span>{{ m.money(paidOrder.amountOwed) }}</span></div>
                    </div>
                    {% if balanceForm %}
                        <div class="text-xs text-ll-ink" role="alert" data-checkout-target="message" hidden></div>
                        <button type="submit" class="ll-cta bg-ll-ink text-ll-bg p-[18px] text-center text-xs leading-[1.5] uppercase tracking-[0.16em]" data-checkout-target="button">Pay balance {{ m.money(paidOrder.amountOwed) }}</button>
                        <div class="text-xs text-ll-mute text-center leading-[1.5]">Payment is processed securely by our payment provider. Your card details are never stored by Llunio Studios.</div>
                        <a href="{{ path('terms') }}" class="text-xs leading-[1.5] text-ll-mute text-center underline transition-colors hover:text-ll-ink">Terms &amp; Conditions</a>
                    {% endif %}
                {% elseif payable %}
                    <div class="text-xs text-ll-ink" role="alert" data-checkout-target="message" hidden></div>
                    <button type="submit" class="ll-cta bg-ll-ink text-ll-bg p-[18px] text-center text-xs leading-[1.5] uppercase tracking-[0.16em]" data-checkout-target="button">Pay {{ m.money(quote.dueNow) }}</button>
                    <div class="text-xs text-ll-mute text-center leading-[1.5]">Payment is processed securely by our payment provider. Your card details are never stored by Llunio Studios.</div>
                    <a href="{{ path('terms') }}" class="text-xs leading-[1.5] text-ll-mute text-center underline transition-colors hover:text-ll-ink">Terms &amp; Conditions</a>
                {% endif %}
            </aside>
        {% if balanceForm %}
            {{ form_end(balanceForm) }}
        {% elseif payable %}
            {{ form_end(form) }}
        {% else %}
            </div>
        {% endif %}
    </div>
{% endblock %}
