{#
    Navbar colour is class-driven so it can adapt to the page:
      - `light`  -> white text/icons over a dark hero image (also toggled at
        runtime by the product-gallery controller based on image luminance).
      - `split`  -> product show layout: on desktop the actions sit over the
        white details column, so they stay dark even when the logo is white.
    Colours are applied via CSS in app.css (.navbar-bar / .navbar-actions).
#}
{% set light = light|default(false) %}
{% set split = split|default(false) %}
<nav id="navbar" class="fixed top-0 inset-x-0 z-40 bg-transparent {{ light ? 'nav-light' : '' }} {{ split ? 'nav-split' : '' }}">
    <div class="navbar-bar mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
        <a class="boldonse-regular text-2xl tracking-tight" href="{{ path('landing') }}">Lluniostudios</a>

        <div class="navbar-actions flex items-center gap-5">
            <a href="{{ path('cart') }}" class="relative" aria-label="Cart">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.137a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                </svg>
                {% set cartCount = cart_item_count() %}
                {% if cartCount > 0 %}
                    <span class="cart-badge absolute -top-1 -right-2 inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-semibold rounded-full">{{ cartCount }}</span>
                {% endif %}
            </a>

            <button type="button" aria-label="Open menu"
                    data-drawer-target="drawer-nav" data-drawer-show="drawer-nav" data-drawer-placement="right" aria-controls="drawer-nav">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>
        </div>
    </div>

    {# Flowbite drawer menu #}
    <div id="drawer-nav" tabindex="-1" aria-labelledby="drawer-nav-label"
         class="fixed top-0 right-0 z-50 h-screen p-6 overflow-y-auto transition-transform translate-x-full bg-white w-72 shadow-xl">
        <button type="button" data-drawer-hide="drawer-nav" aria-controls="drawer-nav"
                class="text-gray-400 bg-transparent hover:bg-gray-100 hover:text-gray-900 rounded-lg text-sm w-8 h-8 absolute top-5 right-5 inline-flex items-center justify-center" aria-label="Close menu">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 14 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>
        </button>
        <ul class="mt-8 space-y-4 text-lg">
            <li><a href="{{ path('landing') }}" class="text-gray-900 hover:text-gray-500">Home</a></li>
            <li><a href="{{ path('products') }}" class="text-gray-900 hover:text-gray-500">Products</a></li>
            <li><a href="{{ path('cart') }}" class="text-gray-900 hover:text-gray-500">Cart</a></li>
            {% if app.user %}
                <li><a href="{{ path('account_orders') }}" class="text-gray-900 hover:text-gray-500">My orders</a></li>
                <li><a href="{{ path('app_logout') }}" class="text-gray-900 hover:text-gray-500">Log out</a></li>
            {% else %}
                <li><a href="{{ path('app_login') }}" class="text-gray-900 hover:text-gray-500">Sign in</a></li>
            {% endif %}
        </ul>
    </div>
</nav>
