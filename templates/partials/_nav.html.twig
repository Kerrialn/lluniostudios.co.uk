{#
    Site nav (design: Site v4 Unified). A solid dark bar in page flow that
    scrolls away with the page, as on the prototype's inner pages.
      - `light` -> transparent over a full-bleed hero image (homepage).
    Text is cream throughout.
    Items with `route: null` are pages from later steps and render as
    dimmed, non-clickable placeholders.
#}
{% set overlay = light|default(false) %}
{% set currentRoute = app.request.attributes.get('_route') %}
{% set basketCount = cart_item_count() %}
{# PLACEHOLDER: Bespoke Commissions has no page until Step 9. #}
{% set items = [
    { label: 'Lighting Designs', route: 'products', active: currentRoute in ['products', 'show_product', 'show_collection'] },
    { label: 'Bespoke Commissions', route: null, active: false },
    { label: 'The Workshop', route: 'workshop', active: currentRoute == 'workshop' },
    { label: basketCount > 0 ? 'Basket (' ~ basketCount ~ ')' : 'Basket', route: 'cart', active: currentRoute starts with 'cart' },
] %}
<nav id="navbar" aria-label="Main"
     class="relative z-40 font-archivo {{ overlay ? 'nav-overlay' : '' }}"
     {{ stimulus_controller('mobile-menu') }}>
    <div class="flex items-center justify-between gap-7 py-[22px] px-[clamp(20px,4vw,56px)]">
        <a href="{{ path('landing') }}" class="shrink-0">
            <img src="{{ asset('images/brand/logo-mark-light.png') }}" alt="Llunio Studios" class="h-[34px] w-auto">
        </a>

        {# Desktop links #}
        <ul class="hidden min-[900px]:flex flex-wrap items-center gap-x-[26px] gap-y-2 ll-label">
            {% for item in items %}
                <li>
                    {% if item.route %}
                        <a href="{{ path(item.route) }}"
                           class="{{ item.active ? 'underline underline-offset-[6px]' : '' }}"
                           {{ item.active ? 'aria-current="page"' : '' }}>{{ item.label }}</a>
                    {% else %}
                        <span class="opacity-40 cursor-default" aria-disabled="true" title="Coming soon">{{ item.label }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

        {# Mobile: basket count + menu button #}
        <div class="flex min-[900px]:hidden items-center gap-1">
            {% if basketCount > 0 %}
                <a href="{{ path('cart') }}" aria-label="Basket, {{ basketCount }} {{ basketCount == 1 ? 'item' : 'items' }}"
                   class="min-w-11 h-11 flex items-center justify-center ll-label tabular-nums">({{ basketCount }})</a>
            {% endif %}
            <button type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"
                    class="w-11 h-11 flex flex-col items-center justify-center gap-1.5"
                    data-mobile-menu-target="openButton" data-action="mobile-menu#open">
                <span class="block w-[22px] h-px bg-current"></span>
                <span class="block w-[22px] h-px bg-current"></span>
                <span class="block w-[22px] h-px bg-current"></span>
            </button>
        </div>
    </div>

    {# Full-screen mobile menu #}
    <div id="mobile-menu" hidden data-mobile-menu-target="panel"
         class="fixed inset-0 z-[60] flex flex-col overflow-auto bg-ll-bg text-ll-ink" role="dialog" aria-modal="true" aria-label="Menu">
        <div class="flex items-center justify-between py-[17px] px-[clamp(20px,4vw,56px)]">
            <a href="{{ path('landing') }}" data-action="mobile-menu#close">
                <img src="{{ asset('images/brand/logo-mark-light.png') }}" alt="Llunio Studios" class="h-[34px] w-auto">
            </a>
            <button type="button" aria-label="Close menu" data-action="mobile-menu#close"
                    class="min-w-11 h-11 flex items-center justify-end gap-2.5 ll-label">
                Close<span class="text-lg leading-none tracking-normal" aria-hidden="true">×</span>
            </button>
        </div>
        <ul class="flex flex-col border-t border-ll-line py-[clamp(24px,6vh,56px)] px-[clamp(20px,4vw,56px)]">
            {% for item in items %}
                <li class="border-b border-ll-line-soft">
                    {% if item.route %}
                        <a href="{{ path(item.route) }}" data-action="mobile-menu#close"
                           class="min-h-16 flex items-center justify-between gap-4 text-[22px] ll-heading"
                           {{ item.active ? 'aria-current="page"' : '' }}>
                            <span>{{ item.label }}</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-ll-ink {{ item.active ? '' : 'opacity-0' }}" aria-hidden="true"></span>
                        </a>
                    {% else %}
                        <span class="min-h-16 flex items-center text-[22px] ll-heading opacity-40" aria-disabled="true">{{ item.label }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
</nav>
