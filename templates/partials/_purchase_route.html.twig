{#
    The Site v4 prototype's purchase route: the "Purchase route" note, the
    "Cast Your Lamp" / "Reserve Your Design" button and the line under it, in
    the prototype's styling (dark theme). Copy comes from App\Service\BasketRules.

    Options:
      reserve  true for the request route
      note     the "Purchase route" note
      href     render the button as a link to this URL; otherwise a submit button
#}
{% set reserve = reserve|default(false) %}
{% set ctaClass = 'll-cta block w-full bg-[#ece3d3] text-[#15120e] p-[18px] text-center font-medium text-xs uppercase tracking-[0.16em]' %}
<div class="flex flex-col gap-[18px] font-archivo">
    <div class="flex flex-col gap-1.5 border-l py-0.5 pl-3.5 {{ reserve ? 'border-ll-ink' : 'border-ll-line' }}">
        <span class="text-[11px] uppercase tracking-[0.16em] text-ll-mute">Purchase route</span>
        <span class="text-xs leading-[1.45] text-ll-mute">{{ note }}</span>
    </div>
    {% if href|default(false) %}
        <a href="{{ href }}" class="{{ ctaClass }}">{{ reserve ? 'Reserve Your Design' : 'Cast Your Lamp' }}</a>
    {% else %}
        <button type="submit" class="{{ ctaClass }}">{{ reserve ? 'Reserve Your Design' : 'Cast Your Lamp' }}</button>
    {% endif %}
    <div class="text-xs text-ll-mute">{{ reserve ? constant('App\\Service\\BasketRules::SUB_RESERVE') : constant('App\\Service\\BasketRules::SUB_DIRECT') }}</div>
</div>
