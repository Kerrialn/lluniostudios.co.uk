{#
    Shown wherever a real photograph doesn't exist yet. Never substitute a
    generated, mocked-up or stand-in image for a missing photo.

    Fills its container, so the parent sets the size, e.g.
        <div class="relative aspect-[4/5]">
            {{ include('partials/_image_coming_soon.html.twig', { title: 'Atelier' }) }}
        </div>

    Options:
      title    optional small label under the rule (e.g. the size or option name)
      compact  true for a single small label ("<title> Image Coming Soon"),
               used where text is overlaid on top (e.g. page heroes)
      class    extra classes for the panel (e.g. a background colour)
#}
{% set label = title|default(false) %}
{% if compact|default(false) %}
    <div class="absolute inset-0 flex items-center justify-center p-6 text-center font-elite text-xs uppercase tracking-[0.14em] text-[#9a9a9a] {{ class|default('bg-ll-surface') }}"
         role="img" aria-label="{{ label ? label ~ ' image' : 'Image' }} coming soon">
        {{ label ? label ~ ' ' }}Image Coming Soon
    </div>
{% else %}
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center text-ll-ink font-elite {{ class|default('bg-ll-surface') }}"
         role="img" aria-label="Image coming soon{{ label ? ': ' ~ label }}">
        <div class="font-light uppercase tracking-[0.06em] text-[clamp(26px,3vw,44px)] leading-tight">Image Coming Soon</div>
        <div class="w-10 h-px bg-ll-ink/35"></div>
        {% if label %}
            <div class="text-[11px] font-medium uppercase tracking-[0.2em] text-ll-mute">{{ label }}</div>
        {% endif %}
    </div>
{% endif %}
