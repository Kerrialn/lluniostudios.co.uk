{% set _flashes = app.flashes %}
{% if _flashes is not empty %}
    <div class="fixed top-4 left-1/2 -translate-x-1/2 z-[60] flex w-full max-w-sm flex-col items-center gap-3 px-4 pointer-events-none">
        {% for type, messages in _flashes %}
            {% for message in messages %}
                {% set isError = type == 'error' %}
                <div data-controller="toast"
                     role="alert"
                     class="pointer-events-auto flex w-full items-center rounded-lg p-4 text-sm shadow-lg transition-all duration-300 ease-out
                            {{ isError ? 'bg-red-50 text-red-800 border border-red-200' : 'bg-gray-900 text-white' }}">
                    <div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg {{ isError ? 'bg-red-100 text-red-500' : 'bg-white/10 text-white' }}">
                        {% if isError %}
                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM10 5a1 1 0 0 1 1 1v4a1 1 0 1 1-2 0V6a1 1 0 0 1 1-1Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
                        {% else %}
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                        {% endif %}
                        <span class="sr-only">{{ isError ? 'Error' : 'Success' }}</span>
                    </div>
                    <div class="ms-3 font-normal">{{ message }}</div>
                    <button type="button" data-action="toast#dismiss" aria-label="Close"
                            class="ms-auto -mx-1.5 -my-1.5 inline-flex h-7 w-7 items-center justify-center rounded-lg
                                   {{ isError ? 'text-red-500 hover:bg-red-100' : 'text-gray-300 hover:bg-white/10 hover:text-white' }}">
                        <svg class="h-3 w-3" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
