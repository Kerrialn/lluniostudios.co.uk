{#
    "Thank you" pages after a form is sent or an order paid ("Reservation
    Received", "Enquiry Received", "Order Confirmed"), laid out
    like the site's other text pages (Contact, Terms & Conditions): heading,
    then the message under a rule. Reference numbers are in the
    confirmation emails, not here.

    Options:
      heading       the page heading
      message       the prototype's message for this page
      lines         further lines under it (e.g. "Gift · Arrive by …")
      confirmation  false to leave out "A confirmation email is on its way to
                    you." (wording pass 11.5, 16 October 2026), or other
                    wording for that line (e.g. the receipt's)
#}
<div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-8">
    {{ include('partials/_page_heading.html.twig', { title: heading }) }}
    <div class="flex flex-col gap-3 border-t border-ll-line pt-4 text-[15px] leading-relaxed text-ll-mute">
        <p>{{ message }}</p>
        {% for line in lines|default([]) %}
            <p>{{ line }}</p>
        {% endfor %}
        {% set confirmation = confirmation ?? true %}
        {% if confirmation is same as(true) %}
            <p>A confirmation email is on its way to you.</p>
        {% elseif confirmation %}
            <p>{{ confirmation }}</p>
        {% endif %}
    </div>
</div>
