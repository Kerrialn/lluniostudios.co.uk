{% extends 'base.html.twig' %}

{# The customer's order history (Step 10.6), styled like the site's other pages. #}
{% block title %}Your Orders | Llunio Studios{% endblock %}
{% block description %}Your orders with Llunio Studios.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    {% set textLink = 'text-[13px] text-ll-mute underline transition-colors hover:text-ll-ink' %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-8">
        <div class="flex justify-between items-baseline gap-4 flex-wrap">
            <h1 class="ll-heading text-[clamp(22px,2vw,32px)]">Your Orders</h1>
            <a href="{{ path('app_logout') }}" class="{{ textLink }}">Sign out</a>
        </div>

        {% if orders is empty %}
            <div class="flex flex-col items-start gap-5 border-t border-ll-line pt-4 text-[15px] leading-relaxed">
                <p class="text-ll-mute">You haven't placed any orders yet.</p>
                <a href="{{ path('lighting_designs') }}" class="border border-ll-ink px-[22px] py-3.5 ll-label transition-opacity hover:opacity-70">Explore our lighting designs</a>
            </div>
        {% else %}
            <div class="flex flex-col border-t border-ll-line">
                {% for order in orders %}
                    {% set lamps = order.items|reduce((n, item) => n + item.quantity, 0) %}
                    <a href="{{ path('account_order_show', { orderNumber: order.orderNumber }) }}"
                       class="flex flex-wrap justify-between items-baseline gap-x-6 gap-y-1 py-5 border-b border-ll-line transition-opacity hover:opacity-70">
                        <span class="flex flex-col gap-1">
                            <span class="text-[15px]">{{ order.orderNumber }}</span>
                            <span class="text-[13px] text-ll-mute">{{ order.createdAt|date('j F Y', 'Europe/London') }} · {{ lamps }} {{ lamps == 1 ? 'lamp' : 'lamps' }}{% if order.giftLine %} · Gift{% endif %}</span>
                        </span>
                        <span class="flex flex-col items-end gap-1">
                            <span class="text-[15px]">{{ order.totalInGbp|format_currency('GBP', {fraction_digit: order.total % 100 == 0 ? 0 : 2}) }}</span>
                            <span class="text-[11px] uppercase tracking-[0.14em] text-ll-mute">{{ order.displayStatus }}</span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
