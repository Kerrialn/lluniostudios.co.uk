{% extends 'base.html.twig' %}
{% block title %}{{ hasPassword ? 'Change password' : 'Set a password' }} — Llunio Studios{% endblock %}
{% block body %}
    <div class="mx-auto max-w-md px-4 pt-28 pb-16">
        <h1 class="boldonse-regular text-3xl text-gray-900 mb-2">{{ hasPassword ? 'Change password' : 'Set a password' }}</h1>
        <p class="text-sm text-gray-500 mb-8">
            {{ hasPassword
                ? 'Update the password for your account.'
                : 'Add a password so you can sign in and view your orders any time.' }}
        </p>

        {{ form_start(form) }}
            <div class="space-y-4">
                {{ form_row(form.plainPassword.first) }}
                {{ form_row(form.plainPassword.second) }}
            </div>
            <button type="submit" class="mt-6 w-full rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800 focus:ring-4 focus:ring-gray-300">
                {{ hasPassword ? 'Update password' : 'Set password' }}
            </button>
        {{ form_end(form) }}

        <a href="{{ path('account_orders') }}" class="block mt-6 text-sm text-gray-500 underline">Back to orders</a>
    </div>
{% endblock %}
