{% extends '@EasyAdmin/page/content.html.twig' %}

{#
    "Mark Delivered" (Step 11.4): confirm, then the order is marked and
    email 06 goes to the customer.
#}
{% block content_title %}Mark order {{ order.orderNumber }} Delivered{% endblock %}

{% block page_actions %}
    <a class="btn btn-secondary" href="{{ backUrl }}">Back to the order</a>
{% endblock %}

{% block main %}
    <p data-delivered-note>
        This marks the order Delivered and emails {{ order.email }} "Your Lumen Forma has arrived".
        <br>Dispatched {{ order.dispatchedAt|date('j F Y', 'Europe/London') }} with {{ order.courierLabel }}, tracking number {{ order.trackingNumber }}{% if order.trackingUrl %} (<a href="{{ order.trackingUrl }}" target="_blank" rel="noopener">track it</a>){% endif %}.
    </p>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('delivered-' ~ order.id) }}">
        <button type="submit" class="btn btn-primary" data-mark-delivered>Mark Delivered and email the customer</button>
    </form>
{% endblock %}
