{% extends 'base.html.twig' %}

{#
    After paying (Site v4 prototype's "Order & Slot Confirmed"), laid out
    like the other thank-you pages (decided 7 October 2026). While the
    payment is still being confirmed (rare for cards; the webhook finishes
    it), the page says so instead.
#}
{% block title %}{{ order.paid ? 'Order & Slot Confirmed' : 'Order Received' }} | Llunio Studios{% endblock %}
{% block description %}Your Lumen Forma order with Llunio Studios is confirmed and added to the studio casting schedule.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    {% if order.paid %}
        {{ include('partials/_received.html.twig', {
            heading: 'Order & Slot Confirmed',
            message: 'Added to Studio Casting Schedule',
            lines: order.giftLine ? ['Gift · ' ~ order.giftLine] : [],
        }) }}
    {% else %}
        {{ include('partials/_received.html.twig', {
            heading: 'Order Received',
            message: "Thank you. We're just confirming your payment and will email you shortly.",
            confirmation: false,
        }) }}
    {% endif %}
{% endblock %}
