{% extends 'base.html.twig' %}
{% block body %}
    <div class="mx-auto max-w-xl px-4 pt-32 pb-16 text-center">
        {% if order.paid %}
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                </svg>
            </div>
            <h1 class="boldonse-regular text-3xl text-gray-900 mb-3">Thank you</h1>
            <p class="text-gray-600 mb-2">Your order <strong>{{ order.orderNumber }}</strong> is confirmed.</p>
            <p class="text-gray-500 text-sm mb-8">A confirmation email is on its way to {{ order.email }}.</p>
        {% else %}
            <h1 class="boldonse-regular text-3xl text-gray-900 mb-3">Order received</h1>
            <p class="text-gray-600 mb-2">Order <strong>{{ order.orderNumber }}</strong> has been placed.</p>
            <p class="text-gray-500 text-sm mb-8">
                Current status: <span class="font-medium">{{ order.status.label }}</span>.
                We'll confirm by email once payment settles.
            </p>
        {% endif %}

        <div class="text-left rounded-xl border border-gray-100 p-6 bg-gray-50">
            {% for item in order.items %}
                <div class="flex justify-between text-sm py-1">
                    <span class="text-gray-900">{{ item.quantity }} × {{ item.productTitle }}</span>
                    <span class="text-gray-900">{{ item.lineTotalInGbp|format_currency('GBP') }}</span>
                </div>
            {% endfor %}
            <div class="flex justify-between text-sm border-t border-gray-200 mt-2 pt-2">
                <span class="text-gray-500">Shipping</span>
                <span class="text-gray-900">{{ order.shippingCost == 0 ? 'Free' : order.shippingCostInGbp|format_currency('GBP') }}</span>
            </div>
            <div class="flex justify-between border-t border-gray-200 mt-2 pt-2">
                <span class="font-semibold text-gray-900">Total</span>
                <span class="font-semibold text-gray-900">{{ order.totalInGbp|format_currency('GBP') }}</span>
            </div>
        </div>

        <a href="{{ path('account_orders') }}" class="inline-block mt-8 text-sm text-gray-900 underline">View your orders</a>
        <p class="mt-2 text-xs text-gray-400">Sign in any time with {{ order.email }} — we'll email you a 6-digit code.</p>

        <a href="{{ path('products') }}" class="block mt-4 text-sm text-gray-500 underline">Continue shopping</a>
    </div>
{% endblock %}
