{% extends 'base.html.twig' %}
{% block body %}
    <div class="mx-auto max-w-xl px-4 pt-28 pb-16">
        <h1 class="boldonse-regular text-3xl text-gray-900 mb-2">Payment</h1>
        <p class="text-sm text-gray-500 mb-8">Step 3 of 3 — Order {{ order.orderNumber }}</p>

        <div class="rounded-xl border border-gray-100 p-6 mb-8 bg-gray-50">
            <div class="flex justify-between text-sm mb-1">
                <span class="text-gray-500">Subtotal</span>
                <span class="text-gray-900">{{ order.subtotalInGbp|format_currency('GBP') }}</span>
            </div>
            <div class="flex justify-between text-sm mb-1">
                <span class="text-gray-500">Shipping{% if order.shippingServiceName %} ({{ order.shippingServiceName }}){% endif %}</span>
                <span class="text-gray-900">{{ order.shippingCost == 0 ? 'Free' : order.shippingCostInGbp|format_currency('GBP') }}</span>
            </div>
            <div class="flex justify-between border-t border-gray-200 mt-2 pt-2">
                <span class="font-semibold text-gray-900">Total</span>
                <span class="font-semibold text-gray-900">{{ order.totalInGbp|format_currency('GBP') }}</span>
            </div>
        </div>

        {% if revolutToken %}
            <div data-controller="revolut-checkout"
                 data-revolut-checkout-token-value="{{ revolutToken }}"
                 data-revolut-checkout-mode-value="{{ revolutMode }}"
                 data-revolut-checkout-complete-url-value="{{ completeUrl }}">

                <label class="block mb-2 text-sm font-medium text-gray-900" for="cardholder">Name on card</label>
                <input id="cardholder" type="text" data-revolut-checkout-target="cardholder"
                       class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 mb-4">

                <label class="block mb-2 text-sm font-medium text-gray-900">Card details</label>
                <div data-revolut-checkout-target="field"
                     class="rounded-lg border border-gray-300 bg-white p-3 min-h-[48px] mb-2"></div>

                <p data-revolut-checkout-target="error" class="hidden text-sm text-red-600 mb-2"></p>

                <button type="button" data-action="revolut-checkout#submit" data-revolut-checkout-target="submit"
                        class="mt-4 w-full rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800">
                    Pay {{ order.totalInGbp|format_currency('GBP') }}
                </button>
            </div>
        {% else %}
            <div class="rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-sm p-4">
                <p class="font-medium mb-1">Payment is not yet enabled.</p>
                <p>Your order <strong>{{ order.orderNumber }}</strong> has been placed and is awaiting payment.
                   Add the Revolut sandbox keys (<code>REVOLUT_SECRET_KEY</code>, <code>REVOLUT_PUBLIC_KEY</code>)
                   to <code>.env.local</code> to enable card payment here.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
