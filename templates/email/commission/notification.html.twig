{#
    To the studio: a new Bespoke Commissions enquiry (email rules, Step
    11.0). At the top: the type, who it's from, how they'd like to be
    contacted and the number of files; then everything the customer sent,
    the names of any files (not attached; they are downloaded from the
    enquiry in admin). Replying answers the customer.
#}
{% extends 'email/_studio.html.twig' %}
{% import 'email/_studio.html.twig' as layout %}
{% set adminUrl = url('admin_commission_enquiry_detail', {entityId: enquiry.id}) %}
{% set adminLabel = 'Open the enquiry in admin' %}
{% if enquiry.client.value == 'home' %}
    {% set rows = {
        'Name': enquiry.name,
        'Email': enquiry.email,
        'Phone': enquiry.phone ?: '—',
        'Preferred contact method': enquiry.contactMethodLabel,
        'Their idea': enquiry.idea,
    } %}
{% else %}
    {% set rows = {
        'Company': enquiry.company,
        'Contact name': enquiry.name,
        'Email': enquiry.email,
        'Phone': enquiry.phone ?: '—',
        'Project type': enquiry.projectType,
        'Location & installation schedule': enquiry.location,
        'The project': enquiry.project ?: '—',
        'Integration requirements': enquiry.integration ?: '—',
    } %}
{% endif %}
{% set summaryRows = {
    'Enquiry': enquiry.enquiryNumber ~ ' · ' ~ enquiry.createdAt|date('j F Y, H:i', 'Europe/London'),
    'Type': enquiry.client.label ~ (enquiry.projectType ? ' · ' ~ enquiry.projectType : ''),
    'From': enquiry.company ? enquiry.name ~ ', ' ~ enquiry.company : enquiry.name,
    'Contact by': enquiry.client.value == 'home' ? (enquiry.contactMethodLabel ?: 'Email') : 'Email',
    'Files': enquiry.files|length == 0 ? 'None' : enquiry.files|length ~ (enquiry.files|length == 1 ? ' file' : ' files'),
} %}

{% block title %}{{ subject }}{% endblock %}
{% block kind %}New commission enquiry{% endblock %}

{% block details %}
{{ layout.section('Details') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for key, value in rows %}
        <tr><td width="35%" style="{{ keyStyle }}">{{ key }}</td><td style="{{ valueStyle }}">{{ value|nl2br }}</td></tr>
    {% endfor %}
    <tr><td width="35%" style="{{ keyStyle }}">Files</td><td style="{{ valueStyle }}">
        {% for file in enquiry.files %}
            {{ file.originalName }} ({{ file.size >= 1048576 ? (file.size / 1048576)|number_format(1) ~ 'MB' : max(1, (file.size / 1024)|round) ~ 'KB' }}){% if not loop.last %}<br>{% endif %}
        {% else %}
            None
        {% endfor %}
        {% if enquiry.files|length > 0 %}<br><a href="{{ adminUrl }}" style="color:#ece3d3;">Download from the enquiry in admin</a>{% endif %}
    </td></tr>
</table>
{% endblock %}
