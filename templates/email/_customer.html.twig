{#
    The layout of every customer email (Site v4 design, Llunio Email
    Templates), with the email rules decided 9 October 2026 (Step 11.0):
    the Montage C header (logo top-left), no heading block, "Dear {first
    name}," (the buyer's, tidied by GreetingName; "Dear Customer," when none
    is usable) then a blank line and the email's text, all body text one size
    (15px, as the personal note), the design's numbered sections, and the
    footer with "Dorset Studio" (no phone line until a number is given,
    question 18).

    Each email sets firstName and fills the blocks: title, preheader and
    content. The styles below are for the content:
    - body: a paragraph of body text (a blank line after it);
    - label: a small muted label above a value;
    - section(number, name): the numbered rule opening a section;
    - keyStyle / valueStyle: a row of a breakdown table; strongKey /
      strongValue: its total row;
    - fine: small muted print (e.g. "Photography is illustrative…");
    - button(url, text): the cream button.
#}
{% set f = "font-family:'Archivo',Helvetica,Arial,sans-serif;" %}
{% set body = 'margin:0 0 24px 0;' ~ f ~ 'font-size:15px;line-height:24px;mso-line-height-rule:exactly;color:#ece3d3;' %}
{% set label = 'margin:0 0 10px 0;' ~ f ~ 'font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#a89b86;' %}
{% set ruleCell = 'border-top:1px solid #ece3d3;padding:12px 0 0 0;' ~ f ~ 'font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;' %}
{% set keyStyle = 'padding:10px 0;border-bottom:1px solid #3a342b;' ~ f ~ 'font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#a89b86;' %}
{% set valueStyle = 'padding:10px 0;border-bottom:1px solid #3a342b;' ~ f ~ 'font-size:15px;line-height:24px;mso-line-height-rule:exactly;color:#ece3d3;text-align:right;' %}
{% set strongKey = 'padding:14px 0 10px 0;' ~ f ~ 'font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#ece3d3;' %}
{% set strongValue = 'padding:14px 0 10px 0;' ~ f ~ 'font-weight:500;font-size:15px;line-height:24px;mso-line-height-rule:exactly;color:#ece3d3;text-align:right;' %}
{% set fine = 'margin:0 0 16px 0;' ~ f ~ 'font-size:12px;line-height:18px;color:#a89b86;' %}
{% macro section(number, name) %}
{% set ruleCell = "border-top:1px solid #ece3d3;padding:12px 0 0 0;font-family:'Archivo',Helvetica,Arial,sans-serif;font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;" %}
<div style="height:16px;line-height:16px;font-size:1px;">&nbsp;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="{{ ruleCell }}color:#ece3d3;">{{ number }}</td><td style="{{ ruleCell }}color:#a89b86;text-align:right;">{{ name }}</td></tr></table>
<div style="height:20px;line-height:20px;font-size:1px;">&nbsp;</div>
{% endmacro %}
{% macro button(url, text) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" bgcolor="#ece3d3" style="background:#ece3d3;">
<a href="{{ url }}" target="_blank" style="display:block;padding:18px 24px;font-family:'Archivo',Helvetica,Arial,sans-serif;font-weight:500;font-size:12px;line-height:16px;text-transform:uppercase;letter-spacing:0.16em;color:#15120e;text-decoration:none;">{{ text }}</a>
</td></tr></table>
{% endmacro %}
{% import _self as layout %}
<!DOCTYPE html>
<html lang="en-GB" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{% block title %}{% endblock %}</title>
<style>
@media only screen and (max-width:620px){.wrap{width:100% !important;}.px{padding-left:24px !important;padding-right:24px !important;}}
:root{color-scheme:light dark;supported-color-schemes:light dark;}
</style>
</head>
<body style="margin:0;padding:0;background:#15120e;-webkit-text-size-adjust:100%;">
<span style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">{% block preheader %}{% endblock %}</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#15120e" style="background:#15120e;">
<tr><td align="center" style="padding:0;">
<table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#15120e;">
<tr><td bgcolor="#15120e" style="background:#15120e;padding:0;"><img src="{{ absolute_url(asset('images/email/header-montage-c.jpg')) }}" width="600" alt="Llunio Studios — Llunio lamps" style="display:block;width:100%;max-width:600px;height:auto;border:0;outline:none;text-decoration:none;{{ f }}font-size:13px;line-height:20px;letter-spacing:0.22em;text-transform:uppercase;color:#ece3d3;"></td></tr>
<tr><td class="px" style="padding:44px 40px 8px 40px;">
<p style="{{ body }}" data-email-greeting>{{ firstName|default(null) ? 'Dear ' ~ firstName ~ ',' : 'Dear Customer,' }}</p>
{% block content %}{% endblock %}
</td></tr>
<tr><td style="padding:40px 0 0 0;"></td></tr>
<tr><td class="px" style="padding:0 40px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="height:1px;line-height:1px;font-size:1px;background:#3a342b;">&nbsp;</td></tr></table></td></tr>
<tr><td class="px" style="padding:28px 40px 40px 40px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td valign="top" style="{{ f }}font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#a89b86;">Llunio Studios<br>{{ studio_email }}<br>{{ constant('App\\Service\\EmailService::STUDIO_ADDRESS') }}</td>
<td valign="top" align="right" width="90"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
<td style="padding:0 0 0 12px;"><a href="https://www.instagram.com/llunio_studios/" target="_blank" title="Llunio Studios on Instagram"><img src="{{ absolute_url(asset('images/email/icon-instagram.png')) }}" width="24" height="24" alt="Instagram" style="display:block;width:24px;height:24px;border:0;{{ f }}font-size:11px;color:#a89b86;"></a></td>
<td style="padding:0 0 0 12px;"><a href="https://www.youtube.com/@LlunioStudios" target="_blank" title="Llunio Studios on YouTube"><img src="{{ absolute_url(asset('images/email/icon-youtube.png')) }}" width="24" height="24" alt="YouTube" style="display:block;width:24px;height:24px;border:0;{{ f }}font-size:11px;color:#a89b86;"></a></td>
</tr></table></td></tr></table>
<p style="margin:24px 0 0 0;{{ f }}font-size:12px;line-height:18px;color:#a89b86;">You're receiving this email about your order or enquiry with Llunio Studios. Hand cast in our Dorset Studio.</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
