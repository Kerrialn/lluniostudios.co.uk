{#
    Confirming a newsletter sign-up (the maintenance page; question 20).
    Laid out by email/_customer.html.twig (the email rules of Step 11.0);
    the wording is unchanged until the wording pass (Step 11.5).
#}
{% extends 'email/_customer.html.twig' %}
{% import 'email/_customer.html.twig' as layout %}
{% trans_default_domain 'email' %}
{% set firstName = name|trim|split(' ')|first %}

{% block title %}{{ 'news-letter-signup'|trans }}{% endblock %}

{% block content %}
<p style="{{ body }}">{{ 'thank-you-trader-for-joining'|trans }}</p>
{{ layout.button(absolute_url(path('newsletter_verify_email', { token: token })), 'confirm-email'|trans) }}
{% endblock %}
