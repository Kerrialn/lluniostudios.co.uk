{#
    The quote (Step 10b.2), in the style of email 02 (Site v4 design; the
    prototype has no quote email): "Dear {first name}," (decided 8 October
    2026), the opening, the studio's note (its own paragraph), then each
    design with its configuration and quoted price, extra lines, delivery and
    the total (no VAT: not VAT-registered), what to pay now (all of it, or
    the deposit and the balance to pay later), the estimated casting date,
    and "Pay now" (the private quote page) with the date it is valid until.
    Rendered from what is being sent (Quotes::view()). Laid out by
    email/_customer.html.twig (the email rules of Step 11.0).
#}
{% extends 'email/_customer.html.twig' %}
{% import 'email/_customer.html.twig' as layout %}
{% macro money(pence) %}{{ (pence / 100)|format_currency('GBP', {fraction_digit: pence % 100 == 0 ? 0 : 2}) }}{% endmacro %}
{% import _self as m %}
{% set firstName = designRequest.firstName %}

{% block title %}Your Lumen Forma quote, {{ designRequest.fullName }}{% endblock %}
{% block preheader %}Your quote for Lumen Forma request {{ designRequest.requestNumber }} is ready. Valid until {{ validUntil|date('j F Y', 'Europe/London') }}.{% endblock %}

{% block content %}
<p style="{{ body }}">Thank you for your patience. Here is our quote for your Lumen Forma request {{ designRequest.requestNumber }}.</p>
{% if quote.note %}<p style="{{ body }}" data-email-note>{{ quote.note|nl2br }}</p>{% endif %}
{{ layout.section('01', 'Your configuration') }}
{% set quoted = {} %}
{% for lamp in quote.lamps|filter(l => l.item) %}{% set quoted = quoted|merge({ (lamp.item.id.toRfc4122): lamp.unitPrice }) %}{% endfor %}
{{ include('email/request/_lamps.html.twig', { quoted: quoted }) }}
{{ layout.section('02', 'Quote') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for lamp in quote.lamps %}
        <tr><td width="60%" style="{{ keyStyle }}">{{ lamp.label }}{% if lamp.quantity > 1 %} × {{ lamp.quantity }}{% endif %}</td><td style="{{ valueStyle }}">{{ m.money(lamp.total) }}</td></tr>
    {% endfor %}
    {% for extra in quote.extras %}
        <tr><td width="60%" style="{{ keyStyle }}">{{ extra.label }}</td><td style="{{ valueStyle }}">{{ m.money(extra.total) }}</td></tr>
    {% endfor %}
    <tr><td width="60%" style="{{ keyStyle }}">Delivery · {{ quote.deliveryLabel }}</td><td style="{{ valueStyle }}">{{ m.money(quote.deliveryPrice) }}</td></tr>
    <tr><td width="60%" style="{{ strongKey }}">Total</td><td style="{{ strongValue }}">{{ m.money(quote.total) }}</td></tr>
    {% if quote.deposit %}
        <tr><td width="60%" style="{{ keyStyle }}">Deposit to pay now ({{ quote.depositPercent }}%)</td><td style="{{ valueStyle }}">{{ m.money(quote.dueNow) }}</td></tr>
        <tr><td width="60%" style="{{ keyStyle }}">Balance to pay later</td><td style="{{ valueStyle }}">{{ m.money(quote.balance) }}</td></tr>
    {% endif %}
</table>
{{ layout.section('03', 'Casting') }}
<p style="{{ label }}">Estimated casting date</p>
<p style="{{ body }}">{{ quote.castingDate|date('j F Y') }}</p>
{% if designRequest.gift %}
    <p style="{{ label }}">Gift</p>
    <p style="{{ body }}" data-email-gift>Needed by {{ designRequest.giftNeededBy|date('j F Y') }}{% if designRequest.giftSendTo %}<br>{{ designRequest.giftSendTo.label }}{% endif %}</p>
{% endif %}
<div style="height:8px;line-height:8px;font-size:1px;">&nbsp;</div>
{{ layout.button(url('quote_show', { token: token }), 'Pay now · ' ~ m.money(quote.dueNow)) }}
<div style="height:24px;line-height:24px;font-size:1px;">&nbsp;</div>
<p style="{{ body }}">This quote is valid until {{ validUntil|date('j F Y', 'Europe/London') }}. Reply to this email with any questions.</p>
{% endblock %}
