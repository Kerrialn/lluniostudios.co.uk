{#
    The requested lamps for the request emails (Site v4 email 02 "REPEAT PER
    LAMP" block): one block per design, or per lamp when customised lamp by
    lamp. Rows: Size, The Pigment, Cable, Footing, Light, Quantity, Price.
#}
{% set f = "font-family:'Archivo',Helvetica,Arial,sans-serif;" %}
{% set keyStyle = 'padding:10px 0;border-bottom:1px solid #3a342b;' ~ f ~ 'font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#a89b86;' %}
{% set valueStyle = 'padding:10px 0;border-bottom:1px solid #3a342b;' ~ f ~ 'font-size:14px;line-height:20px;color:#ece3d3;text-align:right;' %}
{% set items = designRequest.items %}
{% for item in items %}
    {% set direct = item.product and item.product.directOrder %}
    {% set price = (item.unitPrice / 100)|format_currency('GBP', {fraction_digit: 0}) %}
    {% for group in item.lampConfigurations %}
        {% set lamp = loop.index0 + (item.customisedIndividually ? 1 : 0) %}
        {% set labels = [] %}
        {% if items|length > 1 %}{% set labels = labels|merge(['Design ' ~ loop.parent.loop.index ~ ' of ' ~ items|length]) %}{% endif %}
        {% if group.label %}{% set labels = labels|merge([group.label ~ ' of ' ~ item.quantity]) %}{% elseif item.quantity > 1 %}{% set labels = labels|merge(['Same configuration for each lamp']) %}{% endif %}
        {% set light = item.value('Bulb Style', lamp) ~ (item.value('Bulb Count', lamp) ? ' / ' ~ item.value('Bulb Count', lamp) : '') %}
        <p style="margin:{{ loop.parent.loop.first and loop.first ? '0' : '32px' }} 0 4px 0;{{ f }}font-weight:300;font-size:22px;line-height:28px;letter-spacing:0.03em;text-transform:uppercase;color:#ece3d3;">Lumen Forma</p>
        {% if labels is not empty %}<p style="margin:0 0 10px 0;{{ f }}font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#a89b86;">{{ labels|join(' · ') }}</p>{% endif %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            {% for key, value in {
                'Size': item.sizeName,
                'The Pigment': item.value('The Pigment', lamp),
                'Cable': item.value('Cable Colour', lamp),
                'Footing': item.value('Footing Material', lamp),
                'Light': light,
                'Quantity': group.label ? 1 : item.quantity,
                'Price': (direct ? '' : 'Starting at ') ~ price ~ ((group.label ? 1 : item.quantity) > 1 ? ' each' : ''),
            } %}
                <tr><td width="40%" style="{{ keyStyle }}">{{ key }}</td><td style="{{ valueStyle }}">{{ value }}</td></tr>
            {% endfor %}
        </table>
    {% endfor %}
{% endfor %}
