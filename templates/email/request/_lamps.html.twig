{#
    The requested lamps for the request emails (Site v4 email 02 "REPEAT PER
    LAMP" block): one block per design, or per lamp when customised lamp by
    lamp. Rows: Size, The Pigment, Cable, Footing, Light, Quantity, Price; for a
    larger piece reserved with its size only (7b.4), Finishes ("To be chosen
    together") in place of the four options.
    quoted (optional, the quote email): the quoted price for each lamp, by
    the request item's id; shown in place of the size's price.
    Text at the body size (15px), as the email rules of Step 11.0.
#}
{% set f = "font-family:'Special Elite','Courier New',Courier,monospace;" %}
{% set keyStyle = 'padding:10px 0;border-bottom:1px solid #3a342b;' ~ f ~ 'font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#a89b86;' %}
{% set valueStyle = 'padding:10px 0;border-bottom:1px solid #3a342b;' ~ f ~ 'font-size:15px;line-height:24px;mso-line-height-rule:exactly;color:#ece3d3;text-align:right;' %}
{% set items = designRequest.items %}
{% set quoted = quoted|default({}) %}
{% for item in items %}
    {% set direct = item.product and item.product.directOrder %}
    {% set quotedPrice = quoted[item.id.toRfc4122] ?? null %}
    {% set pence = quotedPrice ?? item.unitPrice %}
    {% set price = (pence / 100)|format_currency('GBP', {fraction_digit: pence % 100 == 0 ? 0 : 2}) %}
    {% for group in item.lampConfigurations %}
        {% set lamp = loop.index0 + (item.customisedIndividually ? 1 : 0) %}
        {% set labels = [] %}
        {% if items|length > 1 %}{% set labels = labels|merge(['Design ' ~ loop.parent.loop.index ~ ' of ' ~ items|length]) %}{% endif %}
        {% if group.label %}{% set labels = labels|merge([group.label ~ ' of ' ~ item.quantity]) %}{% elseif item.quantity > 1 and not item.finishesToBeChosen %}{% set labels = labels|merge(['Same configuration for each lamp']) %}{% endif %}
        {% set light = item.value('Bulb Style', lamp) ~ (item.value('Bulb Count', lamp) ? ' / ' ~ item.value('Bulb Count', lamp) : '') %}
        <p style="margin:{{ loop.parent.loop.first and loop.first ? '0' : '32px' }} 0 4px 0;{{ f }}font-weight:500;font-size:15px;line-height:24px;letter-spacing:0.08em;text-transform:uppercase;color:#ece3d3;">Lumen Forma</p>
        {% if labels is not empty %}<p style="margin:0 0 10px 0;{{ f }}font-size:11px;line-height:16px;mso-line-height-rule:exactly;text-transform:uppercase;letter-spacing:0.14em;color:#a89b86;">{{ labels|join(' · ') }}</p>{% endif %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            {% set options = item.finishesToBeChosen
                ? { (constant('App\\Catalogue\\LumenFormaCatalogue::FINISHES_KEY')): constant('App\\Catalogue\\LumenFormaCatalogue::FINISHES_VALUE') }
                : { 'The Pigment': item.value('The Pigment', lamp), 'Cable': item.value('Cable Colour', lamp), 'Footing': item.value('Footing Material', lamp), 'Light': light } %}
            {% for key, value in { 'Size': item.sizeName }|merge(options)|merge({
                'Quantity': group.label ? 1 : item.quantity,
                'Price': (direct or quotedPrice is not null ? '' : 'Starting at ') ~ price ~ ((group.label ? 1 : item.quantity) > 1 ? ' each' : ''),
            }) %}
                <tr><td width="40%" style="{{ keyStyle }}">{{ key }}</td><td style="{{ valueStyle }}">{{ value }}</td></tr>
            {% endfor %}
        </table>
    {% endfor %}
{% endfor %}
