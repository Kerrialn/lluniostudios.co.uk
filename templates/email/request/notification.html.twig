{#
    To the studio: a new "Reserve Your Design" request (email rules, Step
    11.0). At the top: the lamps by size and quantity, any Custom choices,
    that no payment has been taken, a gift's "Needed by" date; then
    everything the customer sent (the names of any reference photos, not
    attached: they are downloaded from the request in admin) and the
    configuration. Replying answers the customer.
#}
{% extends 'email/_studio.html.twig' %}
{% import 'email/_studio.html.twig' as layout %}
{% set neededBy = giftDate %}
{% set directGift = designRequest.directGift %}
{% set giftMessage = designRequest.giftMessage %}
{% set adminUrl = url('admin_design_request_detail', {entityId: designRequest.id}) %}
{% set adminLabel = 'Open the request in admin' %}
{% set summaryRows = {
    'Request': designRequest.requestNumber ~ ' · ' ~ designRequest.createdAt|date('j F Y, H:i', 'Europe/London'),
    'Lamps': lamps|join(', '),
} %}
{% if customNames is not empty %}{% set summaryRows = summaryRows|merge({ 'Custom': customNames|join(', ')|capitalize }) %}{% endif %}
{% if designRequest.files|length > 0 %}{% set summaryRows = summaryRows|merge({ 'Reference photos': designRequest.files|length ~ (designRequest.files|length == 1 ? ' file' : ' files') }) %}{% endif %}
{% set summaryRows = summaryRows|merge({ 'Customer': designRequest.fullName }) %}
{% if designRequest.directGift %}{% set summaryRows = summaryRows|merge({ 'Recipient': designRequest.giftRecipientName }) %}{% endif %}
{% set summaryRows = summaryRows|merge({ 'Payment': 'None taken' }) %}

{% block title %}{{ subject }}{% endblock %}
{% block kind %}New request{% endblock %}

{% block details %}
{{ layout.section('Customer') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for key, value in {
        'Name': designRequest.fullName,
        'Email': designRequest.email,
        'Phone': designRequest.phone,
        'Delivery address': designRequest.deliveryAddress,
        'Site access & delivery notes': designRequest.accessNotes ?: '—',
        'Gift': designRequest.giftLabel,
    }|merge(designRequest.directGift ? {
        "Recipient's name": designRequest.giftRecipientName,
        'Gift message': designRequest.giftMessage ?: '—',
        "Recipient's mobile": designRequest.giftRecipientPhone ?: '— (the carrier has the customer\'s phone)',
    } : {}) %}
        <tr><td width="35%" style="{{ keyStyle }}">{{ key }}</td><td style="{{ valueStyle }}">{{ value|nl2br }}</td></tr>
    {% endfor %}
    {% if designRequest.customDetails is not null %}
        <tr><td width="35%" style="{{ keyStyle }}">Custom details</td><td style="{{ valueStyle }}">{{ (designRequest.customDetails ?: '—')|nl2br }}</td></tr>
        <tr><td width="35%" style="{{ keyStyle }}">Reference photos</td><td style="{{ valueStyle }}">
            {% for file in designRequest.files %}
                {{ file.originalName }} ({{ file.size >= 1048576 ? (file.size / 1048576)|number_format(1) ~ 'MB' : max(1, (file.size / 1024)|round) ~ 'KB' }}){% if not loop.last %}<br>{% endif %}
            {% else %}
                None
            {% endfor %}
            {% if designRequest.files|length > 0 %}<br><a href="{{ adminUrl }}" style="color:#ece3d3;">Download from the request in admin</a>{% endif %}
        </td></tr>
    {% endif %}
</table>
{{ layout.section('Configuration') }}
{{ include('email/request/_lamps.html.twig') }}
{% endblock %}
