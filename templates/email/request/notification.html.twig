{#
    To the studio: a new "Reserve Your Design" request (email rules, Step
    11.0). At the top: the lamps by size and quantity, any Custom choices,
    that no payment has been taken, a gift's "Needed by" date; then
    everything the customer sent and the configuration. Replying answers
    the customer.
#}
{% extends 'email/_studio.html.twig' %}
{% import 'email/_studio.html.twig' as layout %}
{% set neededBy = giftDate %}
{% set adminUrl = url('admin_design_request_detail', {entityId: designRequest.id}) %}
{% set adminLabel = 'Open the request in admin' %}
{% set summaryRows = {
    'Request': designRequest.requestNumber ~ ' · ' ~ designRequest.createdAt|date('j F Y, H:i', 'Europe/London'),
    'Lamps': lamps|join(', '),
}|merge(customNames is not empty ? { 'Custom': customNames|join(', ')|capitalize } : {})|merge({
    'Customer': designRequest.fullName,
    'Payment': 'None taken',
}) %}

{% block title %}{{ subject }}{% endblock %}
{% block kind %}New request{% endblock %}

{% block details %}
{{ layout.section('Customer') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for key, value in {
        'Name': designRequest.fullName,
        'Email': designRequest.email,
        'Phone': designRequest.phone,
        'Delivery address': designRequest.deliveryAddress,
        'Site access & delivery notes': designRequest.accessNotes ?: '—',
    } %}
        <tr><td width="35%" style="{{ keyStyle }}">{{ key }}</td><td style="{{ valueStyle }}">{{ value|nl2br }}</td></tr>
    {% endfor %}
    {% if designRequest.customDetails is not null %}
        <tr><td width="35%" style="{{ keyStyle }}">Custom details</td><td style="{{ valueStyle }}">{{ (designRequest.customDetails ?: '—')|nl2br }}</td></tr>
    {% endif %}
</table>
{{ layout.section('Configuration') }}
{{ include('email/request/_lamps.html.twig') }}
{% endblock %}
