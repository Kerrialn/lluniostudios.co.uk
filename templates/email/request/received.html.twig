{#
    Email 02, "Request received" (Site v4 design, Llunio Email Templates/
    02-request-received.html), with "The Pigment" for the design's Form/Finish
    rows and "Dorset Studio" for "Bournemouth". The opening sentence depends
    on why the design was reserved (RequestReceivedCopy). Laid out by
    email/_customer.html.twig (the email rules of Step 11.0).
#}
{% extends 'email/_customer.html.twig' %}
{% import 'email/_customer.html.twig' as layout %}
{% set firstName = designRequest.firstName %}

{% block title %}We have your request, {{ designRequest.fullName }}{% endblock %}
{% block preheader %}Your Lumen Forma request {{ designRequest.requestNumber }} has reached the studio. We will be in touch.{% endblock %}

{% block content %}
<p style="{{ body }}">Thank you for your request. {{ opening }}</p>
<p style="{{ body }}">{{ constant('App\\Service\\RequestReceivedCopy::SECURED') }}</p>
{{ layout.section('01', 'Request') }}
<p style="{{ label }}">Request number</p>
<p style="{{ body }}">{{ designRequest.requestNumber }}</p>
{% if designRequest.gift %}
    <p style="{{ label }}">Gift</p>
    <p style="{{ body }}" data-email-gift>Needed by {{ designRequest.giftNeededBy|date('j F Y') }}{% if designRequest.giftSendTo %}<br>{{ designRequest.giftSendTo.label }}{% if designRequest.directGift %}: {{ designRequest.giftRecipientName }}{% endif %}{% endif %}</p>
    {% if designRequest.directGift and designRequest.giftMessage %}
        <p style="{{ label }}">Gift message</p>
        <p style="{{ body }}" data-email-gift-message>{{ designRequest.giftMessage|nl2br }}</p>
    {% endif %}
{% endif %}
{{ layout.section('02', 'Your configuration') }}
{{ include('email/request/_lamps.html.twig') }}
<div style="height:28px;line-height:28px;font-size:1px;">&nbsp;</div>
<p style="{{ fine }}">Photography is illustrative of the Lumen Forma series. Each lamp is cast to your configuration and is unique.</p>
{% endblock %}
