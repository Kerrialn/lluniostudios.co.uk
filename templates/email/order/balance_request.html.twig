{#
    Requesting the balance (Step 10b.4), in the style of the quote email:
    "Dear {first name},", the opening, the studio's personal note (if any,
    its own paragraph, as the quote email's note), the order total, what was
    paid and the balance, and "Pay balance" (the quote page). Sent from admin
    ("Request balance"). Laid out by email/_customer.html.twig (the email
    rules of Step 11.0).
#}
{% extends 'email/_customer.html.twig' %}
{% import 'email/_customer.html.twig' as layout %}
{% macro money(pence) %}{{ (pence / 100)|format_currency('GBP', {fraction_digit: pence % 100 == 0 ? 0 : 2}) }}{% endmacro %}
{% import _self as m %}

{% block title %}Your Lumen Forma balance, {{ order.designRequest.fullName }}{% endblock %}
{% block preheader %}The balance for your Lumen Forma order {{ order.orderNumber }}: {{ m.money(order.amountOwed) }}.{% endblock %}

{% block content %}
<p style="{{ body }}">Here is the balance for your Lumen Forma order {{ order.orderNumber }}.</p>
{% if note %}<p style="{{ body }}" data-email-note data-balance-note>{{ note|nl2br }}</p>{% endif %}
{{ layout.section('01', 'Balance') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td width="60%" style="{{ keyStyle }}">Order total</td><td style="{{ valueStyle }}">{{ m.money(order.total) }}</td></tr>
    <tr><td width="60%" style="{{ keyStyle }}">Paid {{ order.paidAt|date('j F Y', 'Europe/London') }}</td><td style="{{ valueStyle }}">{{ m.money(order.amountPaid) }}</td></tr>
    <tr><td width="60%" style="{{ strongKey }}">Balance to pay</td><td style="{{ strongValue }}">{{ m.money(order.amountOwed) }}</td></tr>
</table>
<div style="height:32px;line-height:32px;font-size:1px;">&nbsp;</div>
{{ layout.button(url('quote_show', { token: token }), 'Pay balance · ' ~ m.money(order.amountOwed)) }}
<div style="height:24px;line-height:24px;font-size:1px;">&nbsp;</div>
<p style="{{ body }}">Reply to this email with any questions.</p>
{% endblock %}
