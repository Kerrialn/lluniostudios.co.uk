{#
    The receipt once the balance is paid (Step 10b.4), rebuilt from the
    Site v4 email template (Step 11.0) as email 01's sections: "Dear {first
    name},", the opening, 01 Order (the order number), 02 Payments (the
    deposit, the balance, paid in full). Laid out by
    email/_customer.html.twig.
#}
{% extends 'email/_customer.html.twig' %}
{% import 'email/_customer.html.twig' as layout %}
{% macro money(pence) %}{{ (pence / 100)|format_currency('GBP', {fraction_digit: pence % 100 == 0 ? 0 : 2}) }}{% endmacro %}
{% import _self as m %}

{% block title %}Your Lumen Forma order is paid in full{% endblock %}
{% block preheader %}I've received your balance for order {{ order.orderNumber }}.{% endblock %}

{% block content %}
<p style="{{ body }}">Thank you. I've received your balance of {{ m.money(balance) }}, and your Lumen Forma order {{ order.orderNumber }} is now paid in full.</p>
{{ include('email/_signature.html.twig') }}
{{ layout.section('01', 'Order') }}
<p style="{{ label }}">Order number</p>
<p style="{{ body }}">{{ order.orderNumber }}</p>
{{ layout.section('02', 'Payments') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td width="60%" style="{{ keyStyle }}">Deposit · {{ order.paidAt|date('j F Y', 'Europe/London') }}</td><td style="{{ valueStyle }}">{{ m.money(order.total - balance) }}</td></tr>
    <tr><td width="60%" style="{{ keyStyle }}">Balance · {{ order.balancePaidAt|date('j F Y', 'Europe/London') }}</td><td style="{{ valueStyle }}">{{ m.money(balance) }}</td></tr>
    <tr><td width="60%" style="{{ strongKey }}">Paid in full</td><td style="{{ strongValue }}">{{ m.money(order.total) }}</td></tr>
</table>
<div style="height:24px;line-height:24px;font-size:1px;">&nbsp;</div>
<p style="{{ body }}">Reply to this email with any questions.</p>
{% endblock %}
