<!DOCTYPE html>
<html lang="en-GB" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="{{ asset('images/llunio-studios-logo-v1.ico') }}" />
    <title>{% block title %}Llunio Studios{% endblock %}</title>
    {#
        Search and link previews (Step 11b, 13 October 2026; the titles,
        descriptions and photo descriptions are DRAFT until the wording pass,
        11.5). Each page sets its title, description (block description), and
        optionally a real photo for previews (block preview_image, a path under
        public/, with block preview_alt) and structured data (block
        structured_data). Only the indexable pages (App\Seo\SearchPages) get a
        canonical link; every other page is "noindex" (here and in the
        X-Robots-Tag header).
    #}
    {% set seoTitle = block('title')|trim %}
    {% set seoDescription = block('description') is defined ? block('description')|trim : '' %}
    {% set seoImage = seo_image(block('preview_image') is defined and block('preview_image')|trim ? block('preview_image')|trim : 'images/home/hero-bright-2560.jpg') %}
    {% set seoImageAlt = block('preview_alt') is defined and block('preview_alt')|trim ? block('preview_alt')|trim : 'A Lumen Forma lamp by Llunio Studios, lit, in a dark room' %}
    {% if seoDescription %}<meta name="description" content="{{ seoDescription }}">{% endif %}
    {% if seo_indexable() %}
        <link rel="canonical" href="{{ seo_canonical() }}">
    {% else %}
        <meta name="robots" content="noindex, nofollow">
    {% endif %}
    <meta property="og:site_name" content="Llunio Studios">
    <meta property="og:locale" content="en_GB">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ seoTitle }}">
    {% if seoDescription %}<meta property="og:description" content="{{ seoDescription }}">{% endif %}
    <meta property="og:url" content="{{ seo_canonical() ?? app.request.uri }}">
    <meta property="og:image" content="{{ seoImage.url }}">
    {% if seoImage.width %}<meta property="og:image:width" content="{{ seoImage.width }}"><meta property="og:image:height" content="{{ seoImage.height }}">{% endif %}
    <meta property="og:image:alt" content="{{ seoImageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seoTitle }}">
    {% if seoDescription %}<meta name="twitter:description" content="{{ seoDescription }}">{% endif %}
    <meta name="twitter:image" content="{{ seoImage.url }}">
    <meta name="twitter:image:alt" content="{{ seoImageAlt }}">
    {% if seo_indexable() %}
        <script type="application/ld+json">{{ seo_business()|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
        {% block structured_data %}{% endblock %}
    {% endif %}
    {% block stylesheets %}
        {{ vite_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ vite_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="min-h-full flex flex-col bg-ll-bg text-ll-ink antialiased font-elite"
      {{ stimulus_controller('symfony/ux-swup/swup', {
          containers: ['#main', '#navbar', '#flashes', '#footer'],
          theme: 'slide',
          cache: true,
          animateHistoryBrowsing: true,
      }) }}
>
{% block navbar %}{{ include('partials/_nav.html.twig') }}{% endblock %}

{# Kept outside #main so Swup's transform on #main never traps the toast under the navbar. #}
<div id="flashes">{{ include('partials/_flashes.html.twig') }}</div>

{# Pages not yet restyled keep the original light content area. Restyled pages
   override `main_class` with the dark design, e.g. 'bg-ll-bg text-ll-ink font-elite'. #}
<main class="min-h-[70vh] flex-1 {% block main_class %}bg-white text-gray-900{% endblock %}" id="main">
    {# Remembered choices that have been used (a lamp added, a reservation
       sent): the browser forgets them (forget_choices_controller.js). #}
    {% set forgetChoices = app.request.hasPreviousSession ? app.session.remove('forget_choices') : null %}
    {% if forgetChoices is iterable and forgetChoices is not empty %}<div hidden {{ stimulus_controller('forget-choices', { names: forgetChoices }) }}></div>{% endif %}
    {% block body %}{% endblock %}
</main>

{# Swapped by Swup like #main: pages differ (the homepage pins its icons over
   the photo; Lighting Designs has none), so the footer must change with the
   page however it is reached. Always present, even when a page has no footer. #}
<div id="footer">{% block footer %}{{ include('partials/_footer.html.twig') }}{% endblock %}</div>
</body>
</html>
