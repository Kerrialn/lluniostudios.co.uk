<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="{{ asset('images/llunio-studios-logo-v1.ico') }}" />
    <title>{% block title %}Llunio Studios{% endblock %}</title>
    {% block stylesheets %}
        {{ vite_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ vite_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="min-h-full bg-white text-gray-900 antialiased font-sans"
      {{ stimulus_controller('symfony/ux-swup/swup', {
          containers: ['#main', '#navbar', '#flashes'],
          theme: 'slide',
          cache: true,
          animateHistoryBrowsing: true,
      }) }}
>
{% block navbar %}{{ include('partials/_nav.html.twig') }}{% endblock %}

{# Kept outside #main so Swup's transform on #main never traps the toast under the navbar. #}
<div id="flashes">{{ include('partials/_flashes.html.twig') }}</div>

<main class="min-h-[70vh]" id="main">
    {% block body %}{% endblock %}
</main>
</body>
</html>
