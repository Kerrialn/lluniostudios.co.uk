{% extends 'base.html.twig' %}
{% block title %}Sign in — Llunio Studios{% endblock %}
{% block body %}
    <div class="mx-auto max-w-md px-4 pt-28 pb-16">
        <h1 class="boldonse-regular text-3xl text-gray-900 mb-2">Sign in</h1>

        {% if step == 'code' %}
            <p class="text-sm text-gray-500 mb-8">
                Enter the 6-digit code we emailed{% if email %} to <strong>{{ email }}</strong>{% endif %}.
            </p>

            <form method="post">
                <input type="hidden" name="email" value="{{ email }}">

                <div class="mb-6">
                    <label class="block mb-3 text-center text-sm font-medium text-gray-900">6-digit code</label>
                    {{ form_widget(pinForm) }}
                </div>

                <label class="flex items-center gap-2 mb-6 text-sm text-gray-600">
                    <input type="checkbox" name="_remember_me" class="w-4 h-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900">
                    Keep me signed in
                </label>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800 focus:ring-4 focus:ring-gray-300">
                    Sign in
                </button>
            </form>

            <div class="mt-6 flex items-center justify-between text-sm">
                <form method="post">
                    <input type="hidden" name="email" value="{{ email }}">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="text-gray-900 underline">Resend code</button>
                </form>
                <a href="{{ path('app_login', { reset: 1 }) }}" class="text-gray-500 underline">Use a different email</a>
            </div>
        {% else %}
            <p class="text-sm text-gray-500 mb-8">Enter your email and we'll send you a 6-digit sign-in code.</p>

            <form method="post">
                <div class="mb-6">
                    <label for="email" class="block mb-2 text-sm font-medium text-gray-900">Email</label>
                    <input type="email" id="email" name="email" value="{{ email }}" required autofocus autocomplete="email"
                           class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-gray-900 focus:ring-gray-900">
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800 focus:ring-4 focus:ring-gray-300">
                    Send code
                </button>
            </form>
        {% endif %}
    </div>
{% endblock %}
