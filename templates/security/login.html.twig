{% extends 'base.html.twig' %}

{#
    Sign in (Step 10.6), styled like the site's other form pages. Step 1:
    the email; the sign-in email then has a one-click "Sign in" button and a
    6-digit code. Step 2: the code, as a backup to the button.
#}
{% block title %}Sign In | Llunio Studios{% endblock %}
{% block description %}Sign in to Llunio Studios to see your orders.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    {% set input = 'w-full h-12 px-3.5 bg-transparent text-ll-ink border border-ll-mute rounded-none outline-none text-[15px] leading-[1.5] focus:border-ll-ink' %}
    {% set button = 'll-cta w-full bg-ll-ink text-ll-bg p-[18px] text-center text-xs leading-[1.5] uppercase tracking-[0.16em]' %}
    {% set textLink = 'text-[13px] text-ll-mute underline transition-colors hover:text-ll-ink' %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-8">
        {{ include('partials/_page_heading.html.twig', { title: 'Sign In' }) }}

        <div class="flex flex-col gap-6 border-t border-ll-line pt-4 max-w-[460px] text-[15px] leading-relaxed">
            {% if step == 'code' %}
                <p class="text-ll-mute">Press the button in the email we've sent{% if email %} to <span class="text-ll-ink">{{ email }}</span>{% endif %}, or enter its 6-digit code here.</p>

                <form method="post" class="flex flex-col gap-6">
                    <input type="hidden" name="email" value="{{ email }}">
                    <div class="flex flex-col gap-2">
                        <span class="text-[14px]">6-digit code</span>
                        {{ form_widget(pinForm) }}
                    </div>

                    <label class="min-h-11 flex items-center gap-3 text-[14px] cursor-pointer select-none transition-opacity hover:opacity-70">
                        <input type="checkbox" name="_remember_me" class="peer sr-only">
                        <span class="flex-none w-4 h-4 border border-ll-ink flex items-center justify-center peer-focus-visible:outline peer-focus-visible:outline-1 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ll-ink *:bg-transparent peer-checked:*:bg-ll-ink" aria-hidden="true"><span class="w-2 h-2"></span></span>
                        Keep me signed in
                    </label>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="{{ button }}">Sign in</button>
                </form>

                <div class="flex flex-wrap items-center justify-between gap-4">
                    <form method="post">
                        <input type="hidden" name="email" value="{{ email }}">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                        <button type="submit" class="{{ textLink }}">Send a new email</button>
                    </form>
                    <a href="{{ path('app_login', { reset: 1 }) }}" class="{{ textLink }}">Use a different email</a>
                </div>
            {% else %}
                <p class="text-ll-mute">Enter your email and we'll send you a sign-in link, with a 6-digit code as a backup.</p>

                <form method="post" class="flex flex-col gap-6">
                    <label class="flex flex-col gap-2" for="email">
                        <span class="text-[14px]">Email</span>
                        <input type="email" id="email" name="email" value="{{ email }}" required autofocus autocomplete="email" class="{{ input }}">
                    </label>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="{{ button }}">Send sign-in email</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
