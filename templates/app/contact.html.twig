{% extends 'base.html.twig' %}

{% block title %}Contact | Llunio Studios{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-archivo{% endblock %}

{% block body %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-8">
        <h1 class="ll-heading text-[clamp(22px,2vw,32px)]">Contact Us</h1>

        <address class="not-italic flex flex-col items-start border-t border-ll-line pt-4 text-[15px] leading-relaxed text-ll-mute">
            <a href="mailto:info@lluniostudios.co.uk" class="ll-link text-ll-ink break-all">info@lluniostudios.co.uk</a>
            <a href="https://www.instagram.com/llunio_studios/" target="_blank" rel="noopener noreferrer" class="ll-link text-ll-ink">Instagram</a>
            <a href="https://www.youtube.com/@LlunioStudios" target="_blank" rel="noopener noreferrer" class="ll-link text-ll-ink">YouTube</a>
            <div>Hogsmeade, Higher Merley Ln, Wimborne BH21 3EG</div>
            <div>Llunio Studios is the trading name of Theo Newham.</div>
        </address>

        <div class="border-t border-ll-line pt-4 text-[15px] leading-relaxed">
            <a href="{{ path('terms') }}" class="ll-link">Terms &amp; Conditions</a>
        </div>
    </div>
{% endblock %}
