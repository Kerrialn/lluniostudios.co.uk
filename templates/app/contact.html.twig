{% extends 'base.html.twig' %}

{% block title %}Contact | Llunio Studios{% endblock %}
{% block description %}Contact Llunio Studios, a lighting studio in Bournemouth, Dorset: email info@lluniostudios.co.uk, or follow the studio on Instagram and YouTube.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-8">
        {{ include('partials/_page_heading.html.twig', { title: 'Contact Us' }) }}

        <address class="not-italic flex flex-col items-start border-t border-ll-line pt-4 text-[15px] leading-relaxed text-ll-mute">
            <a href="mailto:{{ studio_email }}" class="ll-link text-ll-ink break-all transition-opacity hover:opacity-70">{{ studio_email }}</a>
            <a href="{{ facebook_url }}" target="_blank" rel="noopener noreferrer" class="ll-link text-ll-ink transition-opacity hover:opacity-70" data-contact-facebook>Facebook</a>
            <a href="https://www.instagram.com/llunio_studios/" target="_blank" rel="noopener noreferrer" class="ll-link text-ll-ink transition-opacity hover:opacity-70">Instagram</a>
            <a href="https://www.youtube.com/@LlunioStudios" target="_blank" rel="noopener noreferrer" class="ll-link text-ll-ink transition-opacity hover:opacity-70">YouTube</a>
            <div>Llunio Studios is the trading name of Theo Newham.</div>
        </address>

        <div class="flex flex-col items-start border-t border-ll-line pt-4 text-[15px] leading-relaxed">
            <a href="{{ path('terms') }}" class="ll-link transition-opacity hover:opacity-70">Terms &amp; Conditions</a>
            <a href="{{ path('privacy') }}" class="ll-link transition-opacity hover:opacity-70">Privacy Policy</a>
            {# Order history (Step 10.6): signing in first if needed. #}
            <a href="{{ path('account_orders') }}" class="ll-link transition-opacity hover:opacity-70">Your orders</a>
        </div>
    </div>
{% endblock %}
