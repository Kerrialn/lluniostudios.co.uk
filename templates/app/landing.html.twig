{% extends 'base.html.twig' %}

{% block body %}
    <div>
        <img class="img-fluid w-100 object-fit-cover" style="height: 100vh" src="{{ asset('uploads/images/' ~ product.images.first.filename) }}"/>
        <div class="container">

            <div class="row g-3 justify-content-center align-items-center" style="padding: 100px 0">
                <div class="col-12 col-md-8">
                    <div class="row g-3 justify-content-center align-items-center">
                        <div class="col-12">
                            <h1 class="boldonse-regular mb-5">{{ product.title }}</h1>
                            <p class="lead">{{ product.description|raw }}</p>
                        </div>
                        {% for image in product.images %}
                            <div class="col-12 col-md-4">
                                <img class="img-fluid w-100 object-fit-cover" style="height: 250px" src="{{ asset('uploads/images/' ~ image.filename) }}" />
                            </div>
                        {% endfor %}
                        <div class="text-end">
                            <a class="btn btn-primary"
                               href="{{ path('show_product', {slug: product.slug }) }}">{{ 'buy-now'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
