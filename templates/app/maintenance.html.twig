{% extends 'simple.base.html.twig' %}

{% block body %}
    <div class="mx-auto max-w-5xl px-4 min-h-screen flex flex-col md:flex-row items-center justify-center gap-12">
        <div class="w-full md:w-1/2 max-w-sm">
            <img src="{{ asset('images/llunio-studios-logo-v1.png') }}" alt="Llunio Studios" class="w-full"/>
        </div>
        <div class="w-full md:w-1/2 max-w-md">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg bg-gray-900 text-white text-sm px-4 py-2">{{ message|capitalize }}</div>
                {% endfor %}
            {% endfor %}

            <div class="space-y-4">
                <p class="text-gray-900">Llunio Studios is currently in the workshop.</p>
                <p class="text-gray-600">
                    We are refining our first collection of liquid stone sculptural lamps, request an
                    invitation to the launch below.
                </p>
                {{ form_start(newsletterSubscriberForm) }}
                    <div class="space-y-3">
                        {{ form_row(newsletterSubscriberForm.name) }}
                        {{ form_row(newsletterSubscriberForm.email) }}
                        <button type="submit"
                                class="w-full rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800">
                            {{ 'request-access'|trans|capitalize }}
                        </button>
                    </div>
                {{ form_end(newsletterSubscriberForm) }}
            </div>
        </div>
    </div>
{% endblock %}
