{% extends 'simple.base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 gap-5">
            <div class="col-12 col-md-4">
                <img src="{{ asset('images/llunio-studios-logo-v1.png') }}" alt="Logo"
                     class="img-fluid w-100 p-3 p-md-0">
            </div>
            <div class="col-12 col-md-1"></div>
            <div class="col-12 col-md-4">

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-dark">
                            {{ message|capitalize }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="card border-0 bg-transparent">
                    <div class="card-body">
                        <div class="vstack gap-4">
                            <div>Llunio Studios is currently in the workshop.</div>
                            <div>
                                We are refining our first collection of liquid stone sculptural lamps, request an
                                invitation to the launch below.
                            </div>
                            {{ form_start(newsletterSubscriberForm) }}
                            <div class="vstack gap-3">
                                {{ form_row(newsletterSubscriberForm.name) }}
                                {{ form_row(newsletterSubscriberForm.email) }}
                                <button type="submit" class="btn btn-primary w-100">{{ 'request-access'|trans|capitalize }}</button>
                            </div>
                            {{ form_end(newsletterSubscriberForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

