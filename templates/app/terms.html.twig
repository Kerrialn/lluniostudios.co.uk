{% extends 'base.html.twig' %}

{% block title %}Terms & Conditions | Llunio Studios{% endblock %}
{% block description %}The terms and conditions for ordering Lumen Forma lamps and bespoke commissions from Llunio Studios.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-archivo{% endblock %}

{% block body %}
    {#
        PLACEHOLDER: wording copied from the Site v4 design. Not yet confirmed
        final or reviewed for consumer-law wording (open question).
    #}
    {% set sections = [
        { h: 'Made-to-order & cancellations', p: 'Every item is made to order. Orders may be cancelled at any time before production begins. You will be notified by email when production starts; after that point, orders are final and cannot be cancelled or refunded. As bespoke cast items, statutory distance selling cancellation rights cease once production commences.' },
        { h: 'Changes & revisions', p: 'We welcome reasonable design revisions before production begins. Once production has started, no further changes can be made.' },
        { h: 'Returns, refunds & replacements', p: 'We do not accept returns or offer refunds for change of mind. We will revise or replace an item only if the finished piece does not match the agreed specifications, or it arrives damaged in transit. Claims must be reported within 7 days of delivery with photographic proof of packaging and damage.' },
        { h: 'Delivery & fees', p: 'Delivery costs are non-refundable. For eligible returns or replacements, we will cover the cost of sending the replacement; customers are responsible for returning the original item unless we confirm it is defective.' },
        { h: 'Governing law & disputes', p: 'These terms are governed by the laws of England and Wales. Any disputes will be handled through our internal process first, and if unresolved, through the courts of England and Wales.' },
    ] %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-8">
        <h1 class="ll-heading text-[clamp(22px,2vw,32px)]">Terms &amp; Conditions</h1>
        {% for section in sections %}
            <section class="flex flex-col gap-2 border-t border-ll-line pt-4">
                <h2 class="ll-label text-[11px]">{{ section.h }}</h2>
                <p class="text-ll-mute text-[15px] leading-relaxed">{{ section.p }}</p>
            </section>
        {% endfor %}
    </div>
{% endblock %}
