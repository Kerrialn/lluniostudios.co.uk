{% extends 'base.html.twig' %}

{#
    "Enquiry Received" (Step 7c.3), laid out like the other thank-you pages
    (partials/_received.html.twig): how they'll be contacted, about their
    piece; no reference number (it is in the customer's email). DRAFT wording
    until the wording pass (11.5).
#}
{% block title %}Enquiry received | Llunio Studios{% endblock %}
{% block description %}Your enquiry about a larger Lumen Forma piece has reached Llunio Studios.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    {{ include('partials/_received.html.twig', {
        heading: 'Enquiry Received',
        message: "Thank you. I'll be in touch " ~ talk.reachPhrase ~ ', to talk about your ' ~ (quantity > 1 ? quantity ~ ' ' ~ size ~ ' lamps' : size) ~ '.',
    }) }}
{% endblock %}
