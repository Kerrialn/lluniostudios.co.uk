<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="{{ asset('images/llunio-studios-logo-v1.ico') }}" />
    <title>{% block title %}Llunio Studios{% endblock %}</title>
    {% block stylesheets %}
        {{ vite_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ vite_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="min-h-full {% block body_class %}bg-white text-gray-900 font-sans{% endblock %} antialiased"
      {{ stimulus_controller('symfony/ux-swup/swup', {
          containers: ['#main', '#flashes'],
          theme: 'slide',
          cache: true,
          animateHistoryBrowsing: true,
      }) }}
>
{% block flashes %}<div id="flashes">{{ include('partials/_flashes.html.twig') }}</div>{% endblock %}

<main class="min-h-screen" id="main">
    {% block body %}{% endblock %}
</main>
</body>
</html>
