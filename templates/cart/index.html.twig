{% extends 'base.html.twig' %}
{% block body %}
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-md-8">
                <h1 class="boldonse-regular mb-3">Cart</h1>

                {% if cart.cartItems is empty %}
                    <p class="text-muted">Your cart is empty.</p>
                    <a href="{{ path('products') }}" class="btn btn-dark">Browse Products</a>
                {% else %}
                    <div class="list-group list-group-flush mb-4">
                        {% for item in cart.cartItems %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">{{ item.product.title }}</h6>
                                        {% for option in item.cartItemOptions %}
                                            <small class="text-muted">{{ option.productOption.name }}: {{ option.productOptionValue.value }}</small><br>
                                        {% endfor %}
                                        <small class="text-muted">{{ (item.unitPrice / 100)|format_currency('GBP') }} each</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold mb-2">{{ ((item.unitPrice * item.quantity) / 100)|format_currency('GBP') }}</div>
                                        <form action="{{ path('cart_update_item', {id: item.id}) }}" method="post" class="d-inline">
                                            <div class="input-group input-group-sm" style="width: 120px;">
                                                <input type="number" name="quantity" value="{{ item.quantity }}" min="0" max="999" class="form-control form-control-sm text-center">
                                                <button type="submit" class="btn btn-outline-dark btn-sm">Update</button>
                                            </div>
                                        </form>
                                        <form action="{{ path('cart_remove_item', {id: item.id}) }}" method="post" class="d-inline mt-2">
                                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">Remove</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% set itemCount = 0 %}
                    {% set cartTotal = 0 %}
                    {% for item in cart.cartItems %}
                        {% set itemCount = itemCount + item.quantity %}
                        {% set cartTotal = cartTotal + (item.unitPrice * item.quantity) %}
                    {% endfor %}

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <div>
                            <span class="text-muted">{{ itemCount }} item{{ itemCount != 1 ? 's' : '' }}</span>
                        </div>
                        <div class="text-end">
                            <span class="fs-5 fw-bold">Total: {{ (cartTotal / 100)|format_currency('GBP') }}</span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
