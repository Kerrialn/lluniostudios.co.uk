{% extends 'base.html.twig' %}
{% block body %}
    <div class="mx-auto max-w-3xl px-4 pt-28 pb-16">
        <h1 class="boldonse-regular text-3xl text-gray-900 mb-8">Cart</h1>

        {% if cart.cartItems is empty %}
            <p class="text-gray-500 mb-6 text-center">Your cart is empty.</p>
        {% else %}
            <div class="divide-y divide-gray-100 border-y border-gray-100 mb-6">
                {% for item in cart.cartItems %}
                    <div class="flex justify-between items-start gap-4 py-4">
                        <div class="flex-1">
                            <h2 class="font-medium text-gray-900">{{ item.product.title|title }}</h2>
                            {% for option in item.cartItemOptions %}
                                <p class="text-sm text-gray-500">{{ option.productOption.name }}: {{ option.productOptionValue.value }}</p>
                            {% endfor %}
                            <p class="text-sm text-gray-500 mt-1">{{ item.unitPriceInGbp|format_currency('GBP') }} each</p>
                        </div>
                        <div class="text-right">
                            <div class="font-semibold text-gray-900 mb-2">{{ item.lineTotalInGbp|format_currency('GBP') }}</div>
                            <form action="{{ path('cart_update_item', {id: item.id}) }}" method="post" class="flex items-center gap-1 justify-end">
                                <input type="number" name="quantity" value="{{ item.quantity }}" min="0" max="999"
                                       class="w-16 rounded-lg border border-gray-300 bg-gray-50 p-1.5 text-sm text-center text-gray-900">
                                <button type="submit" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50">Update</button>
                            </form>
                            <form action="{{ path('cart_remove_item', {id: item.id}) }}" method="post" class="mt-1">
                                <button type="submit" class="text-sm text-red-600 hover:underline">Remove</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="flex justify-between items-center mb-8">
                <span class="text-gray-500">{{ cart.itemCount }} item{{ cart.itemCount != 1 ? 's' }}</span>
                <span class="text-xl font-semibold text-gray-900">Total: {{ cart.totalInGbp|format_currency('GBP') }}</span>
            </div>

            <a href="{{ path('checkout') }}"
               class="block w-full text-center rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800">
                Proceed to checkout
            </a>
        {% endif %}
    </div>
{% endblock %}
