{% extends 'base.html.twig' %}

{#
    The basket ("Your Studio Order"), matched to the Site v4 prototype. Each
    Add to Basket is its own line; a line shows one configuration, or one per
    lamp when customised individually. Instant checkout is limited by
    BasketRules (2 lamps in total, direct sizes, no Custom options); a basket
    that can't check out shows the prototype's "Reserve Your Design" button and
    purchase route note instead of "Proceed to Payment".
    "This is a gift" asks when it must arrive (no earlier than GiftDate's
    earliest date); the choice is checked and saved on the basket when
    "Proceed to Payment" is pressed (CartController, BasketProceedForm).
#}
{% form_theme proceedForm 'form_div_layout.html.twig' %}
{% block title %}Basket | Llunio Studios{% endblock %}
{% block description %}Your Llunio Studios basket: the Lumen Forma lamps you have configured, ready for payment.{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    {% set row = 'flex justify-between gap-4 py-[9px] border-b border-ll-line text-sm leading-[1.5]' %}
    {% set rowKey = 'text-[11px] leading-[1.5] uppercase tracking-[0.14em] text-ll-mute' %}
    {% set textLink = 'self-start text-xs text-ll-mute ll-link hover:text-ll-ink' %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-[clamp(28px,4vw,48px)]">
        <div class="flex justify-between items-baseline gap-4 flex-wrap">
            <h1 class="ll-heading text-[clamp(22px,2vw,32px)]">Your Studio Order</h1>
            {% if cart.cartItems is not empty %}
                <span class="ll-label text-[11px] text-ll-mute">
                    {{ lampCount }} {{ lampCount == 1 ? 'lamp' : 'lamps' }}{% if cart.cartItems|length > 1 %} · {{ cart.cartItems|length }} items{% endif %}
                </span>
            {% endif %}
        </div>

        {% if cart.cartItems is empty %}
            <div class="flex flex-col items-start gap-5 py-6 border-t border-ll-line">
                <p class="text-ll-mute">Your basket is empty.</p>
                <a href="{{ path('lighting_designs') }}" class="border border-ll-ink px-[22px] py-3.5 ll-label transition-opacity hover:opacity-70">Explore our lighting designs</a>
            </div>
        {% else %}
            <div class="flex flex-wrap gap-[clamp(32px,5vw,72px)] items-start">
                <div class="flex-[1.5_1_460px] min-w-0 flex flex-col border-t border-ll-line">
                    {% for item in cart.cartItems %}
                        {% set product = item.product %}
                        <div class="grid grid-cols-[clamp(96px,14vw,160px)_minmax(0,1fr)] gap-[clamp(18px,3vw,32px)] py-7 border-b border-ll-line">
                            {% if product.cardImage %}
                                <img src="{{ asset('uploads/images/' ~ product.cardImage.filename) }}" alt="{{ product.title }}" class="w-full aspect-[3/4] object-cover">
                            {% else %}
                                <div class="relative w-full aspect-[3/4]">
                                    {{ include('partials/_image_coming_soon.html.twig', { compact: true }) }}
                                </div>
                            {% endif %}

                            <div class="flex flex-col gap-[18px] min-w-0">
                                <div class="flex justify-between items-baseline gap-4 flex-wrap">
                                    {# As the prototype: the collection as the title, the size in its own row. #}
                                    <h2 class="ll-heading text-[clamp(17px,1.4vw,20px)]" style="line-height: 1.5">{{ constant('App\\Catalogue\\LumenFormaCatalogue::COLLECTION_NAME') }}</h2>
                                    <span class="text-[15px]">
                                        {{ item.lineTotalInGbp|format_currency('GBP', {fraction_digit: 0}) }}
                                        {% if item.quantity > 1 %}<span class="block text-right text-xs text-ll-mute">{{ item.unitPriceInGbp|format_currency('GBP', {fraction_digit: 0}) }} each</span>{% endif %}
                                    </span>
                                </div>

                                <div class="flex flex-col">
                                    <div class="{{ row }}"><span class="{{ rowKey }}">Size</span><span class="text-right">{{ sizeNames[loop.index0] }}</span></div>
                                    <div class="{{ row }}"><span class="{{ rowKey }}">Quantity</span><span class="text-right">{{ item.quantity }}</span></div>
                                    {% if item.quantity >= 2 %}
                                        <div class="{{ row }}"><span class="{{ rowKey }}">Configuration</span><span class="text-right">{{ item.customisedIndividually ? 'Customise Individually' : 'Customise All' }}</span></div>
                                    {% endif %}
                                </div>

                                {% for group in item.lampConfigurations %}
                                    <div class="flex flex-col">
                                        {% if group.label %}
                                            <div class="text-[13px] pt-1.5 pb-2 border-b border-ll-ink">{{ group.label }}</div>
                                        {% endif %}
                                        {% for option in group.options %}
                                            <div class="{{ row }}"><span class="{{ rowKey }}">{{ option.productOption.name }}</span><span class="text-right">{{ option.productOptionValue.value }}</span></div>
                                        {% endfor %}
                                    </div>
                                {% endfor %}

                                <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                                    {# Lumen Forma lines open in the configurator (per-lamp lines too). #}
                                    {% if product.slug in configuratorSlugs %}
                                        <a href="{{ path('lighting_designs', {edit: item.id}) }}" class="{{ textLink }}">Edit configuration</a>
                                    {% endif %}
                                    <form action="{{ path('cart_remove_item', {id: item.id}) }}" method="post" class="flex">
                                        <button type="submit" class="{{ textLink }}">Remove</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <aside class="flex-[1_1_320px] min-w-0 flex flex-col gap-[18px] p-[clamp(20px,3vw,32px)] bg-ll-surface border border-ll-line">
                    <p class="text-[13px] text-ll-mute leading-normal">Hand-cast to order in our Dorset Studio. Dispatched within {{ lead_time.label }} depending on casting schedule.</p>
                    <div class="flex flex-col">
                        <div class="flex justify-between gap-3 text-[13px] py-2.5 border-t border-ll-line"><span>Subtotal</span><span class="text-right">{{ cart.totalInGbp|format_currency('GBP', {fraction_digit: 0}) }}</span></div>
                        <div class="flex justify-between gap-3 text-[13px] py-2.5 border-t border-b border-ll-line"><span>DPD Next Day Delivery</span><span class="text-right">Calculated before payment</span></div>
                    </div>

                    {% if checkoutBlockers is not empty %}
                        {# Over the lamp limit, a Request size or a Custom choice: the whole order goes by request. #}
                        {{ include('partials/_purchase_route.html.twig', { reserve: true, note: routeNote, href: path('basket_request', {basket: 1}) }) }}
                    {% else %}
                        {{ form_start(proceedForm, { attr: { class: 'flex flex-col gap-[18px]', novalidate: 'novalidate' } }) }}
                            {% set dateErrors = proceedForm.arriveBy.vars.errors %}
                            {# The date appears once "This is a gift" is ticked (no script needed). #}
                            <div class="group flex flex-col gap-3">
                                <label class="min-h-11 flex items-center gap-3 text-[13px] cursor-pointer select-none transition-opacity hover:opacity-70">
                                    {{ form_widget(proceedForm.gift, { attr: { class: 'peer sr-only' } }) }}
                                    <span class="flex-none w-4 h-4 border border-ll-ink flex items-center justify-center peer-focus-visible:outline peer-focus-visible:outline-1 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ll-ink [&>span]:bg-transparent peer-checked:[&>span]:bg-ll-ink" aria-hidden="true"><span class="w-2 h-2"></span></span>
                                    This is a gift
                                </label>
                                <div class="hidden group-has-[input[name$='[gift]']:checked]:flex flex-col gap-2">
                                    <label for="{{ proceedForm.arriveBy.vars.id }}" class="text-[11px] uppercase tracking-[0.14em] text-ll-mute">When does it need to arrive by? *</label>
                                    {{ form_widget(proceedForm.arriveBy, { attr: { class: 'w-full min-h-11 bg-transparent text-ll-ink border ' ~ (dateErrors is empty ? 'border-ll-line' : 'border-ll-ink') ~ ' rounded-none px-3 py-2.5 text-sm leading-[1.5] outline-none [&::-webkit-datetime-edit-fields-wrapper]:py-px focus:border-ll-ink [color-scheme:dark]' } }) }}
                                    <div class="text-xs text-ll-mute leading-normal">Each lamp is made by hand. Please allow {{ lead_time.label }}.</div>
                                    {% for error in dateErrors %}
                                        <div class="text-xs text-ll-ink" role="alert">{{ error.message }}</div>
                                    {% endfor %}
                                    {# Gift options (9 October 2026): to the customer, or directly to the recipient. #}
                                    {{ include('partials/_gift_send_to.html.twig', { field: proceedForm.sendTo }) }}
                                </div>
                            </div>
                            <button type="submit" class="ll-cta bg-ll-ink text-ll-bg py-[18px] text-center text-xs leading-[1.5] uppercase tracking-[0.16em]">Proceed to Payment</button>
                        {{ form_end(proceedForm) }}
                    {% endif %}
                    <a href="{{ path('terms') }}" class="text-xs leading-[1.5] text-ll-mute text-center underline transition-colors hover:text-ll-ink">Terms &amp; Conditions</a>
                </aside>
            </div>
        {% endif %}
    </div>
{% endblock %}
