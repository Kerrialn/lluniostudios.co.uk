{% block pin_code_widget %}
    {% set length = length|default(6) %}
    <div class="flex gap-2" data-controller="pin-code" data-pin-code-length-value="{{ length }}">
        {# Real form field — hidden; the controller writes the joined digits here #}
        <input type="hidden" {{ block('widget_attributes') }}
               {% if value is not empty %}value="{{ value }}"{% endif %}
               data-pin-code-target="hidden">

        {# Visible single-character boxes (not submitted) #}
        {% for i in 1..length %}
            <input type="text"
                   inputmode="numeric"
                   maxlength="1"
                   autocomplete="{{ loop.first ? 'one-time-code' : 'off' }}"
                   aria-label="Digit {{ loop.index }}"
                   data-pin-code-target="input"
                   data-action="input->pin-code#onInput keydown->pin-code#onKeydown paste->pin-code#onPaste focus->pin-code#onFocus"
                   class="block w-12 h-14 text-center text-xl font-light bg-transparent text-ll-ink border border-ll-mute rounded-none outline-none focus:border-ll-ink">
        {% endfor %}
    </div>
{% endblock %}
