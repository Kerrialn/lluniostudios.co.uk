{% block integer_type_widget %}
    {% set type = type|default('text') %}
    {% set attr = attr|merge({
        'data-integer-spinner-target': 'input',
        'data-action': 'keydown->integer-spinner#keydown'
    }) %}
    <div class="input-group custom-number-group" data-controller="integer-spinner">
        {% if attr.min is defined and attr.min >= 0 %}
            <button type="button" class="btn btn-dark" data-action="integer-spinner#decrement">−</button>
        {% endif %}
        {{ block('integer_widget') }}
        <button type="button" class="btn btn-dark" data-action="integer-spinner#increment">+</button>
    </div>
{% endblock %}
