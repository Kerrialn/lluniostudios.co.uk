{% extends 'base.html.twig' %}

{# "Reservation received" (Site v4 prototype's message page), plus the request number. #}
{% block title %}Reservation received | Llunio Studios{% endblock %}
{% block main_class %}bg-ll-bg text-ll-ink font-archivo{% endblock %}

{% block body %}
    <div class="min-h-[70vh] flex flex-col items-center justify-center gap-5 px-[clamp(20px,4vw,56px)] py-[clamp(48px,8vw,120px)] text-center">
        <p class="m-0 max-w-[580px] text-[clamp(18px,1.8vw,22px)] leading-[1.45] [text-wrap:pretty]">Your design request has been received. We are reviewing your specifications and calculating delivery to your location. You will receive a formal quotation, estimated studio casting date, and secure payment link by email within 1–2 working days.</p>
        <p class="m-0 text-[13px] text-ll-mute">Request {{ requestNumber }}</p>
    </div>
{% endblock %}
