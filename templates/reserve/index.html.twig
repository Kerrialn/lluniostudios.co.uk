{% extends 'base.html.twig' %}

{#
    "Reserve Your Design" (Site v4 prototype's Reserve page; the "Reserve Your
    Casting Slot" variant is dropped). The customer's details on the left; on
    the right every lamp in the request (the basket plus the lamp being
    configured), each with its full configuration. No payment is taken.
    Fields, sizes and spacing as the Card Payment page (its field partial),
    with the address in separate fields and a country (8 October 2026).
    Gift options (9 October 2026): "This is a gift" shows the "Needed by"
    date and where to send it; "Send directly to the recipient" shows the
    recipient's name, the gift message and their mobile, and the address
    becomes theirs. Shown and hidden by CSS (no script needed).
    "Custom Details" starts with what was written under the configurator's
    Custom choices (10 October 2026), still editable; under it, optional
    "Reference photos" (the Bespoke Commissions file box and rules; files
    aren't remembered if the visitor leaves the page).
#}
{% block title %}Reserve Your Design | Llunio Studios{% endblock %}
{% block description %}Reserve your Lumen Forma design with Llunio Studios. No payment is taken: the studio reviews every request and sends a quote.{% endblock %}
{% form_theme form 'form_div_layout.html.twig' %}
{% block main_class %}bg-ll-bg text-ll-ink font-elite{% endblock %}

{% block body %}
    {% set section = 'll-section-heading border-t border-ll-line pt-4' %}
    {% set grid = 'grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-x-5 gap-y-4' %}
    <div class="max-w-[1200px] mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,5vw,72px)] flex flex-col gap-[clamp(28px,4vw,48px)]">
        {% set back %}<a href="{{ path('lighting_designs') }}" class="text-[13px] text-ll-mute transition-colors hover:text-ll-ink">← Lumen Forma</a>{% endset %}
        {{ include('partials/_page_heading.html.twig', { title: 'Reserve Your Design', aside: back, gap: 'clamp(28px,4vw,48px)' }) }}
        <div class="max-w-[640px] border-t border-ll-line pt-4">
            <p class="m-0 text-[15px] leading-[1.5] text-ll-mute [text-wrap:pretty]">No payment is taken today. Reserving holds your place in our studio casting schedule while we calculate delivery options and confirm exact lead times.</p>
        </div>

        <div class="flex flex-wrap gap-[clamp(32px,5vw,72px)] items-start">
            {# What is typed is remembered if the visitor leaves and comes back (remember_form_controller.js), until sent. #}
            {% set giftOnly = "[&:has([name$='[gift]']:checked)_[data-gift-only]]:flex" %}
            {% set directOnly = "[&:has([name$='[gift]']:checked):has([name$='[giftSendTo]'][value=recipient]:checked)_[data-direct-only]]:flex" %}
            {{ form_start(form, { attr: { class: 'flex-[1.5_1_460px] min-w-0 flex flex-col gap-6 ' ~ giftOnly ~ ' ' ~ directOnly, novalidate: 'novalidate', 'data-controller': 'remember-form', 'data-remember-form-name-value': 'reserve', 'data-action': 'input->remember-form#save change->remember-form#save' } }) }}
                <div class="{{ section }}">Contact</div>
                <div class="{{ grid }}">
                    {{ include('checkout/_field.html.twig', { child: form.fullName, label: 'Full Name *', wide: true }) }}
                    {{ include('checkout/_field.html.twig', { child: form.email, label: 'Email Address *', hint: '(For sending the invoice and build schedule)', wide: true }) }}
                    {{ include('checkout/_field.html.twig', { child: form.phone, label: 'Phone Number *', hint: '(Required by carriers for heavy-goods delivery scheduling)', wide: true }) }}
                </div>

                <div class="{{ section }}">Gift</div>
                <div class="flex flex-col gap-4" data-reserve-gift>
                    <label class="min-h-11 flex items-center gap-3 text-[14px] cursor-pointer select-none transition-opacity hover:opacity-70">
                        {{ form_widget(form.gift, { attr: { class: 'peer sr-only' } }) }}
                        <span class="flex-none w-4 h-4 border border-ll-ink flex items-center justify-center peer-focus-visible:outline peer-focus-visible:outline-1 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ll-ink *:bg-transparent peer-checked:*:bg-ll-ink" aria-hidden="true"><span class="w-2 h-2"></span></span>
                        This is a gift
                    </label>
                    <div class="hidden flex-col gap-4" data-gift-only>
                        <div class="{{ grid }}">
                            {{ include('checkout/_field.html.twig', { child: form.giftNeededBy, label: 'Needed by *', hint: '(a preferred date, not a guarantee; each lamp is made by hand, please allow ' ~ lead_time.label ~ ')' }) }}
                        </div>
                        {{ include('partials/_gift_send_to.html.twig', { field: form.giftSendTo }) }}
                        <div class="hidden {{ grid }}" data-direct-only>
                            {{ include('checkout/_field.html.twig', { child: form.giftRecipientName, label: "Recipient's full name *", wide: true }) }}
                            {{ include('checkout/_field.html.twig', { child: form.giftRecipientPhone, label: "Recipient's mobile (optional)", hint: "(for the carrier's delivery updates; otherwise yours)", wide: true }) }}
                            {{ include('checkout/_field.html.twig', { child: form.giftMessage, label: 'Gift message (optional)', hint: '(for a card in the box, up to ' ~ constant('App\\Form\\Form\\CardPaymentForm::GIFT_MESSAGE_MAX') ~ ' characters)', area: true, wide: true }) }}
                        </div>
                    </div>
                </div>

                <div class="{{ section }}">Delivery address <span class="normal-case tracking-normal text-[13px]">(Required to calculate exact delivery costs)</span><span class="hidden normal-case tracking-normal text-[13px]" data-direct-only>&nbsp;· the recipient's address: sent directly, with no prices in the box</span></div>
                <div class="{{ grid }}">
                    {{ include('checkout/_field.html.twig', { child: form.addressLine1, label: 'Address line 1 *', wide: true }) }}
                    {{ include('checkout/_field.html.twig', { child: form.addressLine2, label: 'Address line 2', wide: true }) }}
                    {{ include('checkout/_field.html.twig', { child: form.town, label: 'Town/City *' }) }}
                    {{ include('checkout/_field.html.twig', { child: form.county, label: 'County' }) }}
                    {{ include('checkout/_field.html.twig', { child: form.postcode, label: 'Postcode *' }) }}
                    {{ include('checkout/_field.html.twig', { child: form.country, label: 'Country *' }) }}
                </div>
                <div class="{{ grid }}">
                    {{ include('checkout/_field.html.twig', { child: form.accessNotes, label: 'Site Access & Delivery Notes', hint: "(e.g. 'Are there stairs, narrow access, or delivery constraints for heavy items?')", area: true, wide: true }) }}
                    {% if form.customDetails is defined %}
                        {{ include('checkout/_field.html.twig', { child: form.customDetails, label: 'Custom Details', hint: "(Describe what you'd like for each custom option, e.g. target tone or Pantone/RAL code, cable textile or length, footing finish, bulb specification)", area: true, wide: true, attr: { 'data-remember-form-carried': carriedDetails } }) }}
                    {% endif %}
                    {# Reference photos (10 October 2026), with a Custom choice: the Bespoke Commissions file box and rules. #}
                    {% if form.referencePhotos is defined %}
                        <div class="col-[1/-1]">
                            {{ include('commissions/_field.html.twig', { child: form.referencePhotos, label: 'Reference photos', hint: "A photo of anything that shows what you have in mind, whether a colour, a material, a finish or a bulb, helps us get it right. Colours and finishes vary between photos and screens, so we'll confirm the details with you before casting.", kind: 'files', drop: 'Choose photos or files — PDF, DWG, JPG, PNG or HEIC, up to 50MB each, 100MB in total' }) }}
                        </div>
                    {% endif %}
                </div>
                {{ form_errors(form) }}
                <button type="submit" class="ll-cta bg-ll-ink text-ll-bg p-[18px] text-center text-xs leading-[1.5] uppercase tracking-[0.16em]">Reserve Your Design</button>
                <div class="text-[13px] text-ll-mute">{{ constant('App\\Service\\BasketRules::SUB_RESERVE') }}</div>
                {{ include('partials/_privacy_line.html.twig') }}
            {{ form_end(form) }}

            <aside class="flex-[1_1_320px] min-w-0 flex flex-col gap-3.5 p-[clamp(20px,3vw,32px)] bg-ll-surface border border-ll-line">
                {% if photo %}
                    <picture>{{ include('partials/_webp_source.html.twig', { srcset: asset('images/lumen-forma/' ~ photo.file ~ '-1000.jpg') }) }}
                    <img src="{{ asset('images/lumen-forma/' ~ photo.file ~ '-1000.jpg') }}" alt="A Lumen Forma {{ (items|first).sizeName }} lamp hand cast in liquid stone" class="w-full aspect-[4/3] object-cover" style="object-position: {{ photo.position }}"></picture>
                {% else %}
                    <div class="relative w-full aspect-[4/3]">{{ include('partials/_image_coming_soon.html.twig', { title: items|length == 1 ? items[0].sizeName : '' }) }}</div>
                {% endif %}
                <div class="text-[11px] uppercase tracking-[0.14em] text-ll-mute">Your configuration</div>
                {% set row = 'flex justify-between gap-4 py-[9px] border-b border-ll-line text-[13px]' %}
                {% for item in items %}
                    <div class="flex flex-col {{ loop.first ? '' : 'mt-4' }}">
                        <div class="{{ row }}"><span class="text-ll-mute">Size</span><span class="text-right">{{ item.sizeName }}</span></div>
                        {% if item.finishesToBeChosen %}
                            {# A larger piece reserved with its size only (7b.4). #}
                            <div class="{{ row }}"><span class="text-ll-mute">{{ constant('App\\Catalogue\\LumenFormaCatalogue::FINISHES_KEY') }}</span><span class="text-right">{{ constant('App\\Catalogue\\LumenFormaCatalogue::FINISHES_VALUE') }}</span></div>
                        {% elseif item.customisedIndividually %}
                            {% for group in item.lampConfigurations %}
                                {% set lamp = loop.index %}
                                {% set bulb = item.value('Bulb Style', lamp) ~ (item.value('Bulb Count', lamp) ? ' / ' ~ item.value('Bulb Count', lamp) : '') %}
                                <div class="{{ row }}"><span class="text-ll-mute">{{ group.label }}</span><span class="text-right">{{ [item.value('The Pigment', lamp), item.value('Cable Colour', lamp), item.value('Footing Material', lamp), bulb]|join(' · ') }}</span></div>
                            {% endfor %}
                        {% else %}
                            <div class="{{ row }}"><span class="text-ll-mute">The Pigment</span><span class="text-right">{{ item.value('The Pigment') }}</span></div>
                            <div class="{{ row }}"><span class="text-ll-mute">Cable Colour</span><span class="text-right">{{ item.value('Cable Colour') }}</span></div>
                            <div class="{{ row }}"><span class="text-ll-mute">Footing Material</span><span class="text-right">{{ item.value('Footing Material') }}</span></div>
                            {% if item.value('Bulb Count') %}
                                <div class="{{ row }}"><span class="text-ll-mute">Bulb Style / Count</span><span class="text-right">{{ item.value('Bulb Style') }} / {{ item.value('Bulb Count') }}</span></div>
                            {% else %}
                                <div class="{{ row }}"><span class="text-ll-mute">Bulb Style</span><span class="text-right">{{ item.value('Bulb Style') }}</span></div>
                            {% endif %}
                        {% endif %}
                        <div class="{{ row }}"><span class="text-ll-mute">Quantity</span><span class="text-right">{{ item.quantity }}</span></div>
                        {% if item.quantity >= 2 and not item.finishesToBeChosen %}
                            <div class="{{ row }}"><span class="text-ll-mute">Configuration</span><span class="text-right">{{ item.customisedIndividually ? 'Customise Individually' : 'Customise All' }}</span></div>
                        {% endif %}
                    </div>
                {% endfor %}
            </aside>
        </div>
    </div>
{% endblock %}
