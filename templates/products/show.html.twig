{% extends 'base.html.twig' %}
{% block body %}
    <div class="grid grid-cols-1 md:grid-cols-2 min-h-screen">
        {# Image gallery #}
        <div class="bg-gray-50">
            {% if product.images is not empty %}
                <div class="md:h-screen md:overflow-y-auto">
                    {% for image in product.images %}
                        <img src="{{ asset('uploads/images/' ~ image.filename) }}"
                             alt="{{ product.title }}"
                             class="w-full object-cover {{ loop.first ? 'md:h-screen' : 'md:h-[70vh]' }}"/>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# Details + add to cart #}
        <div class="flex items-center justify-center px-6 py-24 md:py-0">
            <div class="w-full max-w-md">
                <h1 class="boldonse-regular text-3xl text-gray-900 mb-3">{{ product.title|title }}</h1>
                <p class="text-2xl font-semibold text-gray-900 mb-4">{{ product.priceInGbp|format_currency('GBP') }}</p>
                <p class="text-gray-600 mb-8">{{ product.description }}</p>

                {% for message in app.flashes('message') %}
                    <div class="mb-4 rounded-lg bg-gray-900 text-white text-sm px-4 py-2">{{ message|capitalize }}</div>
                {% endfor %}

                {{ form_start(cartItemForm) }}
                    <div class="space-y-4">
                        {{ form_row(cartItemForm.quantity) }}
                        {% for productOption in product.getProductOptions() %}
                            {% set fieldName = productOption.name|webalize %}
                            {{ form_row(attribute(cartItemForm, fieldName)) }}
                        {% endfor %}
                    </div>
                    <button type="submit"
                            class="mt-6 w-full rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800 focus:ring-4 focus:ring-gray-300">
                        Add to cart
                    </button>
                {{ form_end(cartItemForm) }}
            </div>
        </div>
    </div>
{% endblock %}
