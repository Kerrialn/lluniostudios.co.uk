{% extends 'base.html.twig' %}
{% block body %}
    <div class="row g-0 justify-content-between align-items-center min-vh-100">
        <div class="col-12 col-md-5">
            <div id="product-{{ product.id }}-image-carousel" class="carousel slide d-flex flex-column">
                <div
                    class="d-flex gap-2 justify-content-end align-items-center w-100 position-absolute bottom-0 right-0 z-3 p-3">
                    <a class="btn btn-primary" href="#" type="button"
                       data-bs-target="#product-{{ product.id }}-image-carousel" data-bs-slide="prev">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <a class="btn btn-primary" href="#" type="button"
                       data-bs-target="#product-{{ product.id }}-image-carousel" data-bs-slide="next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
                <div class="carousel-inner z-1">
                    {% for image in product.images %}
                        <div class="carousel-item {{ loop.first ? 'active' }}">
                            <img style="height: 100vh" class="img-fluid w-100 object-fit-cover "
                                 src="{{ asset('uploads/images/' ~ image.filename) }}"/>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="col-12 col-md-7">
            <div class="container">
                <div class="row justify-content-center g-3">
                    <div class="col-12 col-md-8">
                        <h1 class="boldonse-regular mb-3 mt-5">{{ product.title|title }}</h1>
                        <h3 class="boldonse-regular mb-3">{{ product.priceInGbp|format_currency('GBP') }}</h3>
                        <p>{{ product.description }}</p>

                        <div class="">
                            {{ form_start(cartItemForm) }}

                            {{ form_row(cartItemForm.quantity) }}

                            {# Render each dynamic “option_<id>” field here #}
                            <div class="vstack gap-3">
                                {% for productOption in product.getProductOptions() %}
                                    {# fieldName was “option_<id>” in your form type #}
                                    {% set fieldName = productOption.name|webalize %}
                                    <div class="form-group form-floating">
                                        {{ form_widget(attribute(cartItemForm, fieldName)) }}
                                        {{ form_label(attribute(cartItemForm, fieldName)) }}
                                        {{ form_errors(attribute(cartItemForm, fieldName)) }}
                                    </div>
                                {% endfor %}
                            </div>

                            <button type="submit" class="btn btn-primary w-100 my-3">Add to cart</button>

                            {{ form_end(cartItemForm) }}
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
